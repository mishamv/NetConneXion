/* ═══════════════════════════════════════════════════════════════
   NetConneXion — DARK THEME
   Design tokens (from design handoff):
     App bg:        #12141c
     Topbar bg:     #181b28
     Sidebar bg:    #161927
     Panel/card:    #1c2030 / #181b28
     Borders:       #232838 / #2a2f42
     Accent:        #6c7bff
     Active nav bg: #232a45
     Text primary:  #e8e9f0
     Text secondary:#c4c8db
     Text tertiary: #787fa0
     Text disabled: #5b6178
     Success/green: #4ade80
     Warning/yellow:#facc15
     Error/red:     #f87171 / #ef4444
   ═══════════════════════════════════════════════════════════════ */

QWidget {
    color: #e8e9f0;
    background-color: #12141c;
}

QMainWindow {
    background-color: #12141c;
}

QLabel {
    background: transparent;
}

/* ── TOPBAR ───────────────────────────────────────────────────── */
QFrame#Topbar {
    background: #181b28;
    border: none;
    border-bottom: 1px solid #232838;
    border-radius: 0;
}

QLabel#LogoIcon {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                stop:0 #4f7cff, stop:1 #38c98a);
    color: #ffffff;
    border-radius: 6px;
    font-weight: 700;
    font-size: 13px;
}

QLabel#LogoName {
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.2px;
}

QLabel#TopbarTitle {
    color: #787fa0;
    font-size: 13px;
    font-weight: 500;
}

QLabel#TopbarSubtitle {
    color: #5b6178;
}

/* ── SIDEBAR ──────────────────────────────────────────────────── */
QFrame#Sidebar {
    background: #161927;
    border: none;
    border-right: 1px solid #232838;
    border-radius: 0;
}

QFrame#NavFrame {
    background: transparent;
}

QLabel#NavGroupLabel {
    color: #565c74;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 8px 10px 6px 10px;
}

QPushButton#NavBtn {
    text-align: left;
    padding: 0 12px 0 12px;
    min-height: 40px;
    border-radius: 8px;
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    color: #c4c8db;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#NavBtn:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #e8e9f0;
}

QPushButton#NavBtn[active="true"] {
    background: #232a45;
    border-left: 3px solid #6c7bff;
    color: #ffffff;
    font-weight: 600;
}

/* ── CONTENT AREA ─────────────────────────────────────────────── */
QFrame#ContentShell {
    background: transparent;
    border: none;
    border-radius: 0;
}

QWidget#RightWidget {
    background: #12141c;
}

QWidget#Body {
    background: #12141c;
}

QStackedWidget#MainStack {
    background: #12141c;
}

/* ── LEFT PANEL (Profiles list) ───────────────────────────────── */
QFrame#LeftPanel {
    background: #181b28;
    border: none;
    border-right: 1px solid #2a2f42;
    border-radius: 0;
}

QFrame#PanelHeader {
    border-bottom: 1px solid #232838;
}

QLabel#PanelTitle {
    color: #787fa0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#CountPill {
    background: #232a45;
    color: #9aa4ff;
    font-size: 11px;
    font-weight: 700;
    border-radius: 10px;
}

QLineEdit#ProfilesSearch {
    background: #1c2030;
    border: 1px solid #2a2f42;
    color: #e8e9f0;
    border-radius: 8px;
    min-height: 34px;
    font-size: 13px;
}

QLineEdit#ProfilesSearch:focus {
    border-color: #6c7bff;
    background: #1e2238;
}

QComboBox#AdapterFilter {
    background: #1c2030;
    border: 1px solid #2a2f42;
    border-radius: 8px;
    padding: 0 10px;
    min-height: 32px;
    color: #787fa0;
    font-size: 12px;
}

QComboBox#AdapterFilter:focus,
QComboBox#AdapterFilter:on {
    border-color: #6c7bff;
}

QComboBox#AdapterFilter::drop-down {
    border: none;
    width: 28px;
    background: transparent;
}

QComboBox#AdapterFilter::down-arrow {
    image: none;
    width: 8px;
    height: 8px;
    border-left: 2px solid #787fa0;
    border-bottom: 2px solid #787fa0;
    margin-top: -4px;
}

QWidget#ProfileRow {
    background: transparent;
}

QWidget#ProfileRow:hover {
    background: #1c2030;
    border-radius: 8px;
}

QLabel#ProfileName {
    color: #e8e9f0;
    font-size: 14px;
    font-weight: 600;
}

QLabel#ProfileMetaStatic,
QLabel#ProfileMetaDhcp {
    color: #787fa0;
    font-size: 12px;
}

QFrame#ActionsBlock {
    background: transparent;
    border-top: 1px solid #232838;
    border-radius: 0;
}

/* ── RIGHT PANEL (Profile editor) ────────────────────────────── */
QFrame#RightPanel {
    background: #12141c;
    border-radius: 0;
}

QFrame#EditorHeader {
    background: transparent;
    border-bottom: 1px solid #232838;
    border-radius: 0;
}

/* Section cards: ОСНОВНЫЕ / СЕТЬ / DNS */
QFrame#SectionCard {
    background: #1c2030;
    border: 1px solid #2a2f42;
    border-radius: 12px;
}

QLabel#SectionTitle {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #787fa0;
}

QFrame#SectionLine {
    color: #232838;
}

QWidget#SettingsRow {
    background: transparent;
}

QLabel#SettingsHint {
    font-size: 11px;
    color: #565c74;
    background: transparent;
}

QLabel#FieldLabel {
    font-size: 14px;
    color: #c4c8db;
    background: transparent;
}

/* ── INPUTS ───────────────────────────────────────────────────── */
QLineEdit#EditorField {
    background: #12141c;
    border: 1px solid #2a2f42;
    border-radius: 8px;
    color: #e8e9f0;
    padding: 4px 10px;
    min-height: 34px;
}

QLineEdit#EditorField:focus {
    border-color: #6c7bff;
    background: #1a1d2e;
}

QLineEdit#EditorField:disabled {
    color: #5b6178;
    background: #12141c;
    border-color: #232838;
}

QComboBox#EditorCombo {
    background: #12141c;
    border: 1px solid #2a2f42;
    border-radius: 8px;
    color: #e8e9f0;
    padding: 4px 10px;
    min-height: 34px;
}

QComboBox#EditorCombo:focus,
QComboBox#EditorCombo:on {
    border-color: #6c7bff;
    background: #1a1d2e;
}

/* Global inputs */
QLineEdit, QComboBox {
    background: #1c2030;
    border: 1px solid #2a2f42;
    color: #e8e9f0;
    font-size: 14px;
    min-height: 38px;
    border-radius: 8px;
    padding: 0 10px;
}

QLineEdit:focus, QComboBox:focus {
    border-color: #6c7bff;
    background: #1e2238;
}

QComboBox:on {
    border-color: #6c7bff;
    background: #1e2238;
}

QLineEdit:disabled, QComboBox:disabled {
    background: #161927;
    color: #5b6178;
    border-color: #232838;
}

QComboBox::drop-down {
    border-left: 1px solid #232838;
}

QComboBox::down-arrow {
    border-left: 2px solid #787fa0;
    border-bottom: 2px solid #787fa0;
}

QComboBox QAbstractItemView,
QComboBox#EditorCombo QAbstractItemView {
    background: #1c2030;
    border: 1px solid #2a2f42;
    outline: none;
    selection-background-color: #232a45;
    selection-color: #e8e9f0;
    color: #e8e9f0;
}

/* ── BUTTONS ──────────────────────────────────────────────────── */
QPushButton {
    background: #1c2030;
    border: 1px solid #2a2f42;
    color: #c4c8db;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 14px;
    min-height: 30px;
}

QPushButton:hover {
    background: #20243a;
    border-color: #3a3f5c;
    color: #e8e9f0;
}

QPushButton:pressed {
    background: #161927;
}

QPushButton[role="primary"] {
    background: #6c7bff;
    border: none;
    color: #ffffff;
    font-weight: 700;
}

QPushButton[role="primary"]:hover {
    background: #7e8cff;
    border: none;
}

QPushButton[role="primary"]:pressed {
    background: #5a6aee;
}

QPushButton[role="action"] {
    background: #1c2030;
    border: 1px solid #2a2f42;
    color: #c4c8db;
    font-size: 12px;
}

QPushButton[role="action"]:hover {
    background: #20243a;
    color: #e8e9f0;
}

QPushButton[role="delete"] {
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.30);
    color: #f87171;
    font-weight: 600;
}

QPushButton[role="delete"]:hover {
    background: rgba(239, 68, 68, 0.22);
    border-color: rgba(239, 68, 68, 0.50);
    color: #fca5a5;
}

QPushButton[role="delete"]:pressed {
    background: rgba(239, 68, 68, 0.30);
}

QPushButton:disabled {
    background: #1c2030;
    border: none;
    color: #5b6178;
}

QPushButton#BtnSave {
    font-size: 12px;
    font-weight: 600;
    min-height: 0;
    max-height: 9999px;
}

QPushButton#BtnApply {
    font-size: 12px;
    font-weight: 700;
    min-height: 0;
    max-height: 9999px;
}

/* ── SCROLLBARS ───────────────────────────────────────────────── */
QScrollBar:vertical {
    width: 5px;
    background: transparent;
    margin: 4px 1px;
}

QScrollBar::handle:vertical {
    background: #2a2f42;
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #3a3f5c;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ── PLACEHOLDER ──────────────────────────────────────────────── */
QLabel#Placeholder {
    color: #565c74;
}

/* ── DIALOGS ──────────────────────────────────────────────────── */
QDialog {
    background: #1c2030;
    color: #e8e9f0;
}

QDialog QLabel {
    color: #e8e9f0;
    font-size: 13px;
    background: transparent;
}

QMessageBox {
    background: #1c2030;
    color: #e8e9f0;
}

QMessageBox QLabel {
    color: #e8e9f0;
    font-size: 13px;
    background: transparent;
}

QMessageBox QPushButton {
    min-width: 72px;
    min-height: 32px;
    font-size: 13px;
}

/* ── WI-FI PAGE ───────────────────────────────────────────────── */
QTableWidget#WifiNetworkTable,
QTableWidget#WifiProfileTable {
    background: transparent;
    border: none;
    outline: none;
    gridline-color: transparent;
    selection-background-color: transparent;
}

QTableWidget#WifiNetworkTable::item,
QTableWidget#WifiProfileTable::item {
    padding: 4px 8px;
    border: none;
    background: transparent;
    color: #c4c8db;
}

QTableWidget#WifiNetworkTable::item:selected,
QTableWidget#WifiProfileTable::item:selected {
    background: #232a45;
    color: #e8e9f0;
}

QHeaderView::section {
    background: transparent;
    color: #787fa0;
    font-size: 12px;
    font-weight: 600;
    padding: 10px 8px;
    border: none;
    border-bottom: 1px solid #232838;
}

QFrame#WifiStatusBar {
    border-bottom: 1px solid #232838;
    background: transparent;
}

QLabel#WifiStatusLabel {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #787fa0;
    background: transparent;
}

QLabel#WifiFeedback {
    font-size: 13px;
    color: #c4c8db;
    padding: 4px 0;
}

QCheckBox {
    font-size: 13px;
    color: #c4c8db;
    spacing: 6px;
    background: transparent;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #2a2f42;
    background: #1c2030;
}

QCheckBox::indicator:checked {
    background: #6c7bff;
    border-color: #6c7bff;
}

QFrame#WifiTopPanel {
    border-bottom: 1px solid #232838;
    background: #181b28;
}

QFrame#WifiBottomPanel {
    background: #181b28;
    border-top: 1px solid #232838;
}

/* ── WI-FI TABS ───────────────────────────────────────────────── */
QTabWidget#WifiTabs::pane {
    border: none;
    background: transparent;
}

QTabWidget#WifiTabs > QTabBar::tab {
    background: transparent;
    color: #787fa0;
    font-size: 14px;
    font-weight: 500;
    padding: 14px 2px;
    margin: 0 14px 0 0;
    border: none;
    border-bottom: 2px solid transparent;
    min-width: 0;
}

QTabWidget#WifiTabs > QTabBar::tab:selected {
    color: #8f9aff;
    border-bottom: 2px solid #6c7bff;
    font-weight: 600;
}

QTabWidget#WifiTabs > QTabBar::tab:hover:!selected {
    color: #c4c8db;
}

QTabBar {
    background: transparent;
}

QFrame#WifiTabBar {
    border-bottom: 1px solid #232838;
    background: transparent;
}

QFrame#WifiProfileToolbar {
    border-bottom: 1px solid #232838;
    background: transparent;
}

QFrame#WifiProfileToolbar QPushButton {
    min-height: 0;
    max-height: 9999px;
}

QLabel#WifiStatusDetails {
    font-size: 11px;
    color: #787fa0;
    padding-left: 22px;
    background: transparent;
}

/* ── CONTEXT MENU ─────────────────────────────────────────────── */
QMenu {
    background: #1c2030;
    border: 1px solid #2a2f42;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 16px;
    border-radius: 4px;
    font-size: 13px;
    color: #e8e9f0;
    background: transparent;
}
QMenu::item:selected {
    background: #232a45;
    color: #9aa4ff;
}
QMenu::separator {
    height: 1px;
    background: #232838;
    margin: 3px 8px;
}

/* ── TOOLS PAGE ───────────────────────────────────────────────── */
QFrame#ToolsSidebar {
    background: #181b28;
    border-right: 1px solid #2a2f42;
}

QFrame#ToolNavItem {
    background: transparent;
    border-radius: 0;
}
QFrame#ToolNavItem:hover {
    background: rgba(255, 255, 255, 0.04);
}
QFrame#ToolNavItem[active="true"] {
    background: #232a45;
}

QFrame#ToolNavBar {
    background: transparent;
    border-radius: 0 2px 2px 0;
}
QFrame#ToolNavBar[active="true"] {
    background: #6c7bff;
}

QLabel#ToolNavIcon {
    color: #787fa0;
    font-size: 13px;
}
QLabel#ToolNavIcon[active="true"] {
    color: #9aa4ff;
}

QLabel#ToolNavText {
    color: #c4c8db;
    font-size: 13px;
}
QLabel#ToolNavText[active="true"] {
    color: #e8e9f0;
    font-weight: 600;
}

QLabel#ToolGroupLabel {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #565c74;
    padding-left: 14px;
}

QFrame#ToolDivider {
    background: #232838;
    max-height: 1px;
    margin: 0 10px;
}

QLabel#ToolPanelTitle {
    color: #e8e9f0;
    font-size: 19px;
    font-weight: 700;
}

/* Netstat / tree tables */
QTreeWidget#NetstatTable,
QTreeWidget#ToolTree {
    background: transparent;
    border: none;
    border-radius: 8px;
    outline: none;
}
QTreeWidget#NetstatTable::item,
QTreeWidget#ToolTree::item {
    color: #c4c8db;
    padding: 3px 6px;
}
QTreeWidget#NetstatTable::item:hover,
QTreeWidget#ToolTree::item:hover {
    background: rgba(255, 255, 255, 0.04);
}
QTreeWidget#NetstatTable::item:selected,
QTreeWidget#NetstatTable::item:selected:active,
QTreeWidget#NetstatTable::item:selected:!active,
QTreeWidget#ToolTree::item:selected,
QTreeWidget#ToolTree::item:selected:active,
QTreeWidget#ToolTree::item:selected:!active {
    background: #232a45;
    color: #e8e9f0;
}
QTreeWidget#NetstatTable QHeaderView::section,
QTreeWidget#ToolTree QHeaderView::section {
    background: #1e2338;
    color: #9aa4ff;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 6px;
    border: none;
    border-bottom: 1px solid #2a2f42;
}

QTableWidget#NetstatTable {
    background: transparent;
    border: none;
    border-radius: 8px;
    outline: none;
    gridline-color: #232838;
}
QTableWidget#NetstatTable::item {
    color: #c4c8db;
    padding: 3px 6px;
    border: none;
}
QTableWidget#NetstatTable::item:hover {
    background: rgba(255, 255, 255, 0.04);
}
QTableWidget#NetstatTable::item:selected,
QTableWidget#NetstatTable::item:selected:active,
QTableWidget#NetstatTable::item:selected:!active {
    background: #232a45;
    color: #e8e9f0;
}
QTableWidget#NetstatTable QHeaderView::section {
    background: #1e2338;
    color: #9aa4ff;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 6px;
    border: none;
    border-bottom: 1px solid #2a2f42;
    border-right: 1px solid #2a2f42;
}
QTableWidget#NetstatTable QHeaderView::section:last {
    border-right: none;
}

QTreeWidget#IpconfigTree {
    background: transparent;
    border: none;
    margin-top: 10px;
    outline: none;
}
QTreeWidget#IpconfigTree::item {
    color: #e8e9f0;
    border: none;
}
QTreeWidget#IpconfigTree::item:hover {
    background: transparent;
}
QTreeWidget#IpconfigTree::item:hover:!selected {
    background: transparent;
    color: #e8e9f0;
}
QTreeWidget#IpconfigTree::item:selected,
QTreeWidget#IpconfigTree::item:selected:hover {
    background: #232a45;
    color: #9aa4ff;
}
QTreeWidget#IpconfigTree::branch {
    background: transparent;
    border: none;
}
QTreeWidget#IpconfigTree::branch:hover,
QTreeWidget#IpconfigTree::branch:selected,
QTreeWidget#IpconfigTree::branch:selected:active,
QTreeWidget#IpconfigTree::branch:hover:selected {
    background: transparent;
    border: none;
}
QTreeWidget#IpconfigTree::branch:has-children:!has-siblings:closed,
QTreeWidget#IpconfigTree::branch:has-children:has-siblings:closed {
    image: url({ASSETS}/arrow-right-dark.svg);
    background: transparent;
}
QTreeWidget#IpconfigTree::branch:has-children:!has-siblings:open,
QTreeWidget#IpconfigTree::branch:has-children:has-siblings:open {
    image: url({ASSETS}/arrow-down-dark.svg);
    background: transparent;
}
QTreeWidget#IpconfigTree QHeaderView::section {
    background: #1e2338;
    border: none;
    border-bottom: 1px solid #232838;
    border-right: 1px solid #232838;
    padding: 4px 8px;
    font-weight: 600;
    color: #787fa0;
}

QTextEdit#ToolOutput {
    background: #1c2030;
    border: 1px solid #232838;
    border-radius: 8px;
    color: #e8e9f0;
    selection-background-color: #6c7bff;
    selection-color: #ffffff;
    margin-top: 10px;
}

QLabel#SubnetLabel  { color: #c4c8db; }
QLabel#SubnetValue  { color: #e8e9f0; }

QFrame#SpeedCard {
    background: #1c2030;
    border: 1px solid #232838;
    border-radius: 10px;
}
QLabel#SpeedCardTitle { color: #787fa0; }
QLabel#SpeedCardValue { color: #e8e9f0; }
QLabel#SpeedCardUnit  { color: #565c74; }

QLabel#ToolStatus {
    color: #787fa0;
}

QLabel#ToolPanelSubtitle {
    color: #787fa0;
    font-size: 13px;
}

QLineEdit#ToolInput {
    background: #1c2030;
    border: 1px solid #2a2f42;
    border-radius: 8px;
    color: #e8e9f0;
}

QLineEdit#ToolInput:focus {
    border-color: #6c7bff;
    background: #1e2238;
}

QSpinBox#ToolSpinBox {
    background: #1c2030;
    border: 1px solid #2a2f42;
    color: #e8e9f0;
}

QSpinBox#ToolSpinBox:disabled {
    color: #5b6178;
    background: #161927;
}

/* ── TOOLS BUTTONS ────────────────────────────────────────────── */
QPushButton#ToolBtn[role="primary"]:pressed {
    background: #5a6aee;
}

QPushButton#ToolBtn[role="action"]:pressed {
    background: #161927;
}

QPushButton#ToolNavBtn:pressed {
    background: #232a45;
}

QComboBox#ToolCombo {
    background: #1c2030;
    border: 1px solid #2a2f42;
    color: #e8e9f0;
    max-width: 180px;
    padding: 0 8px;
    font-size: 13px;
    min-height: 28px;
    border-radius: 6px;
}

QComboBox#ToolCombo:focus,
QComboBox#ToolCombo:on {
    border-color: #6c7bff;
    background: #1e2238;
}

QComboBox#ToolCombo::drop-down {
    border: none;
    width: 20px;
}

QComboBox#ToolCombo QAbstractItemView {
    background: #1c2030;
    border: 1px solid #2a2f42;
    color: #e8e9f0;
    selection-background-color: #232a45;
}

QSpinBox#SettingsSpinBox {
    background: #1c2030;
    border: 1px solid #2a2f42;
    border-radius: 7px;
    color: #e8e9f0;
    font-size: 13px;
    padding: 0 8px;
    min-height: 0;
    max-height: 9999px;
}

QSpinBox#SettingsSpinBox::up-button,
QSpinBox#SettingsSpinBox::down-button {
    width: 0;
    border: none;
}

/* ── EMPTY STATE (Инструменты → Netstat без данных) ──────────── */
QLabel#EmptyStateIcon {
    color: #565c74;
    font-size: 32px;
}

QLabel#EmptyStateTitle {
    color: #787fa0;
    font-size: 14px;
    font-weight: 600;
}

QLabel#EmptyStateHint {
    color: #565c74;
    font-size: 13px;
}

/* ── STATUS LABELS (реиспользуются на разных страницах) ───────── */
QLabel#StatusDot   { color: #4ade80; }
QLabel#StatusActive { color: #e8e9f0; font-size: 13px; }
QLabel#StatusKey    { color: #787fa0; font-size: 12px; }
QLabel#StatusValue  { color: #c4c8db; font-size: 12px; }
QLabel#StatusIP     { color: #6c7bff; font-size: 12px; font-family: "Consolas", monospace; }
