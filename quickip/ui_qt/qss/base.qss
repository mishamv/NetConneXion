/* ═══════════════════════════════════════════════════════════════
   NetConneXion v2.0 — LIGHT THEME (F: White + Indigo)
   Backdrop: {LIGHT_HEX_F1F5F9}  Sidebar: {LIGHT_HEX_FFFFFF}  Cards: {LIGHT_HEX_FFFFFF}
   Accent: {LIGHT_HEX_4F46E5} indigo
   ═══════════════════════════════════════════════════════════════ */

* {
    font-family: "Segoe UI", system-ui, sans-serif;
    font-size: 14px;
    outline: none;
}

QWidget {
    color: {LIGHT_HEX_1E293B};           /* глобальный текст — slate-800 */
    background: transparent;
}

QWidget#RootWindow {
    background: transparent;  /* фон рисует BackdropWidget ({LIGHT_HEX_F1F5F9}) */
}

/* ── SIDEBAR ──────────────────────────────────────────────────── */
QFrame#Sidebar {
    background: {LIGHT_HEX_FFFFFF};      /* sidebar — белый */
    border: 1px solid {LIGHT_HEX_E8EDF5}; /* рамка sidebar */
    border-radius: 14px;
}

/* Logo area */
QFrame#LogoArea {
    background: transparent;
    border-bottom: 1px solid {LIGHT_HEX_F0F4FA}; /* разделитель под логотипом */
    border-radius: 0;
}

QLabel#LogoIcon {
    background: {LIGHT_HEX_4F46E5};      /* иконка-плашка N — indigo */
    color: {LIGHT_HEX_FFFFFF};
    font-size: 13px;
    font-weight: 700;
    border-radius: 8px;
}

QLabel#LogoName {
    font-size: 13px;
    font-weight: 700;
    color: {LIGHT_HEX_1E293B};           /* название приложения */
}

QLabel#LogoVersion {
    font-size: 9px;
    color: {LIGHT_HEX_94A3B8};           /* версия — slate-400 */
}

/* Nav */
QFrame#NavFrame {
    background: transparent;
}

QLabel#NavGroupLabel {
    font-size: 10px;
    font-weight: 700;
    color: {LIGHT_HEX_CBD5E1};           /* заголовок группы: NETWORK / SYSTEM */
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 0 8px 4px 8px;
}

QPushButton#NavBtn {
    text-align: left;
    padding: 0 12px 0 14px;
    min-height: 44px;
    border-radius: 8px;
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    color: {LIGHT_HEX_64748B};           /* неактивная nav кнопка — slate-500 */
    font-size: 15px;
    font-weight: 500;
}

QPushButton#NavBtn:hover {
    background: {LIGHT_HEX_F1F5F9};
    color: {LIGHT_HEX_1E293B};
    border-left: 3px solid {LIGHT_HEX_CBD5E1};
}

QPushButton#NavBtn[active="true"] {
    background: {LIGHT_HEX_EEF2FF};      /* активная nav — indigo-50 */
    color: {LIGHT_HEX_4338CA};           /* текст активной — indigo-700 */
    font-weight: 700;
    border-left: 3px solid {LIGHT_HEX_4338CA};
}

/* Status block */
QFrame#StatusBlock {
    background: transparent;
    border-top: 1px solid {LIGHT_HEX_F0F4FA}; /* разделитель над статусом */
    border-radius: 0;
}

QLabel#StatusDot {
    color: {LIGHT_HEX_22C55E};           /* зелёная точка — connected */
    font-size: 8px;
}

QLabel#StatusActive {
    font-size: 10px;
    font-weight: 600;
    color: {LIGHT_HEX_334155};           /* активный профиль */
}

QLabel#StatusKey {
    font-size: 10px;
    color: {LIGHT_HEX_94A3B8};           /* ключ: "Adapter" */
}

QLabel#StatusValue {
    font-size: 10px;
    font-weight: 600;
    color: {LIGHT_HEX_334155};           /* значение: "Ethernet" */
}

QLabel#StatusIP {
    font-size: 10px;
    color: {LIGHT_HEX_4F46E5};           /* IP адрес — indigo */
    font-family: "Consolas", "Courier New", monospace;
    font-weight: 600;
}

/* ── TOPBAR ───────────────────────────────────────────────────── */
QFrame#Topbar {
    background: {LIGHT_HEX_FFFFFF};      /* topbar — белый */
    border: 1px solid {LIGHT_HEX_E8EDF5};
    border-radius: 12px;
}

QLabel#TopbarTitle {
    font-size: 15px;
    font-weight: 700;
    color: {LIGHT_HEX_1E293B};           /* заголовок страницы */
}

QLabel#TopbarSubtitle {
    font-size: 10px;
    color: {LIGHT_HEX_94A3B8};           /* подзаголовок: "4 saved · Office active" */
}

/* ── CONTENT SHELL ────────────────────────────────────────────── */
QFrame#ContentShell {
    background: {LIGHT_HEX_FFFFFF};      /* основная рабочая область — белый */
    border: 1px solid {LIGHT_HEX_E8EDF5};
    border-radius: 14px;      /* скругление всех углов */
}

/* ── LEFT PANEL ───────────────────────────────────────────────── */
QFrame#LeftPanel {
    background: {LIGHT_HEX_FFFFFF};      /* левая панель — белый */
    border-right: 1px solid {LIGHT_HEX_E8EDF5}; /* разделитель между панелями */
    border-radius: 14px 0 14px 14px; /* все углы кроме верхнего правого */
}

QFrame#PanelHeader {
    background: transparent;
    border-bottom: 1px solid {LIGHT_HEX_F1F5F9}; /* разделитель под заголовком */
}

QLabel#PanelTitle {
    font-size: 10px;
    font-weight: 700;
    color: {LIGHT_HEX_CBD5E1};           /* заголовок "All profiles" */
    text-transform: uppercase;
    letter-spacing: 1.2px;
}

QLabel#CountPill {
    background: {LIGHT_HEX_EEF2FF};      /* пилюля счётчика — indigo-50 */
    color: {LIGHT_HEX_3730A3};           /* текст счётчика — indigo-800 */
    font-size: 9px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 99px;
}

QFrame#SearchWrap {
    background: transparent;
}

QLineEdit#ProfilesSearch {
    background: {LIGHT_HEX_F8FAFC};      /* фон поля поиска */
    border: 1px solid {LIGHT_HEX_E2E8F0}; /* рамка поиска */
    border-radius: 8px;
    padding: 0 10px;
    min-height: 32px;
    color: {LIGHT_HEX_1E293B};
    font-size: 12px;
}

QLineEdit#ProfilesSearch:focus {
    border-color: {LIGHT_HEX_A5B4FC};   /* рамка поиска при фокусе — indigo-300 */
    background: {LIGHT_HEX_FFFFFF};
}

QComboBox#AdapterFilter {
    background: {LIGHT_HEX_F8FAFC};
    border: 1px solid {LIGHT_HEX_E2E8F0};
    border-radius: 8px;
    padding: 0 10px;
    min-height: 32px;
    color: {LIGHT_HEX_64748B};
    font-size: 12px;
}

QComboBox#AdapterFilter:focus,
QComboBox#AdapterFilter:on {
    border-color: {LIGHT_HEX_A5B4FC};
    background: {LIGHT_HEX_FFFFFF};
}

QComboBox#AdapterFilter::drop-down {
    border: none;
    width: 28px;
    background: transparent;
}

QComboBox#AdapterFilter::down-arrow {
    image: none;
    width: 8px;
    height: 8px;
    border-left: 2px solid {LIGHT_HEX_94A3B8};
    border-bottom: 2px solid {LIGHT_HEX_94A3B8};
    margin-top: -4px;
}

/* Profile list */
QListWidget#ProfilesList {
    background: transparent;
    border: none;
    outline: none;
    padding: 4px 0 0 0;   /* нижний padding убран — убирает пустоту после последней строки */
}

QListWidget#ProfilesList::viewport {
    background: transparent;
}

QListWidget#ProfilesList::item {
    background: transparent;
    border: none;
    padding: 0;
}

QListWidget#ProfilesList::item:selected {
    background: transparent; /* выделение рисуется в ProfileRowWidget.paintEvent */
}

QWidget#ProfileRow {
    background: transparent;
}

QWidget#ProfileRow:hover {
    background: {LIGHT_HEX_F8FAFC};      /* hover строки профиля — очень лёгкий */
    border-radius: 10px;
}

QLabel#ProfileName {
    font-size: 14px;
    font-weight: 600;
    color: {LIGHT_HEX_1E293B};           /* имя профиля */
    letter-spacing: -0.1px;
}

/* Адаптер + режим в одну строку — "Ethernet · STATIC" */
QLabel#ProfileMetaStatic {
    font-size: 12px;
    color: {LIGHT_HEX_94A3B8};           /* базовый цвет строки адаптера */
}

QLabel#ProfileMetaDhcp {
    font-size: 12px;
    color: {LIGHT_HEX_94A3B8};           /* то же, DHCP */
}

/* Actions block */
QFrame#ActionsBlock {
    background: {LIGHT_HEX_FFFFFF};      /* фон блока кнопок — белый, единый с панелью */
    border-top: 1px solid {LIGHT_HEX_F1F5F9};
    border-radius: 0 0 14px 14px; /* скругление нижних углов — совпадает с LeftPanel */
}

/* ── RIGHT PANEL ──────────────────────────────────────────────── */
QFrame#RightPanel {
    background: {LIGHT_HEX_F8FAFC};      /* фон правой панели — чуть светлее белого */
    border-radius: 0 14px 14px 0;  /* скругление только правых углов */
}

QFrame#EditorHeader {
    background: {LIGHT_HEX_FFFFFF};      /* хедер редактора — белый, без внешней рамки */
    border-bottom: 1px solid {LIGHT_HEX_F1F5F9}; /* тонкий разделитель снизу */
    border-top-right-radius: 13px;    /* скругление верхнего правого угла под ContentShell */
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

QWidget#EditorBody {
    background: transparent;
}

QScrollArea#EditorScroll {
    background: transparent;
    border: none;
}

QScrollArea#EditorScroll > QWidget > QWidget {
    background: transparent;
}

/* Section cards */
QFrame#SectionCard {
    background: {LIGHT_HEX_FFFFFF};      /* фон секции General / Network / DNS */
    border: 1px solid {LIGHT_HEX_E8EDF5}; /* рамка секции */
    border-radius: 12px;
}

QLabel#SectionTitle {
    font-size: 11px;
    font-weight: 700;
    color: {LIGHT_HEX_CBD5E1};           /* заголовок секции — GENERAL, NETWORK, DNS */
    letter-spacing: 1.5px;
}

QFrame#SectionLine {
    color: {LIGHT_HEX_F1F5F9};           /* горизонтальная линия после заголовка секции */
}

QWidget#SettingsRow {
    background: transparent;
}

QLabel#SettingsHint {
    font-size: 11px;
    color: {LIGHT_HEX_94A3B8};
}

QLabel#FieldLabel {
    font-size: 14px;
    color: {LIGHT_HEX_64748B};           /* подпись поля: Name, IP address и т.д. */
    font-weight: 500;
}

/* ── INPUTS ───────────────────────────────────────────────────── */
QLineEdit, QComboBox {
    background: {LIGHT_HEX_F8FAFC};      /* фон полей ввода */
    border: 1px solid {LIGHT_HEX_E2E8F0}; /* рамка полей */
    border-radius: 8px;
    padding: 0 12px;
    min-height: 38px;
    color: {LIGHT_HEX_1E293B};
    font-size: 14px;
    font-family: "Consolas", "Courier New", monospace; /* monospace для IP-адресов */
}

QLineEdit:focus, QComboBox:focus {
    border-color: {LIGHT_HEX_A5B4FC};   /* рамка при фокусе — indigo-300 */
    background: {LIGHT_HEX_FFFFFF};
}

QComboBox:on {
    border-color: {LIGHT_HEX_A5B4FC};
    background: {LIGHT_HEX_FFFFFF};
}

QLineEdit:disabled, QComboBox:disabled {
    background: {LIGHT_HEX_F1F5F9};      /* заблокированное поле */
    color: {LIGHT_HEX_CBD5E1};
    border-color: {LIGHT_HEX_E2E8F0};
}

QComboBox::drop-down {
    width: 26px;
    border-left: 1px solid {LIGHT_HEX_E2E8F0};
    background: transparent;
    border-radius: 0 7px 7px 0;
}

QComboBox::down-arrow {
    image: none;
    border-left: 2px solid {LIGHT_HEX_94A3B8};  /* стрелка ComboBox */
    border-bottom: 2px solid {LIGHT_HEX_94A3B8};
    width: 6px;
    height: 6px;
    margin-top: -2px;
}

QComboBox QAbstractItemView {
    background: {LIGHT_HEX_FFFFFF};
    border: 1px solid {LIGHT_HEX_E2E8F0};
    border-radius: 8px;
    selection-background-color: {LIGHT_HEX_EEF2FF}; /* выбранный элемент */
    selection-color: {LIGHT_HEX_1E293B};
    padding: 4px;
    color: {LIGHT_HEX_1E293B};
}

/* ── BUTTONS ──────────────────────────────────────────────────── */
QPushButton {
    background: {LIGHT_HEX_F8FAFC};
    border: 1px solid {LIGHT_HEX_E2E8F0};
    border-radius: 7px;
    color: {LIGHT_HEX_475569};
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    /* min-height: 30px — ГЛОБАЛЬНЫЙ минимум для всех QPushButton.
       Перебивается только через min-height: 0 в более специфичном селекторе.
       Для BtnSave и BtnApply снято ниже в QPushButton#BtnSave/BtnApply.
       Размер этих кнопок управляется через setFixedSize() в main_window.py */
    min-height: 30px;
}

/* ── BtnSave (кнопка Save в EditorHeader) ─────────────────────────────────
   Размер задаётся через setFixedSize(ширина, высота) в main_window.py.
   min-height: 0 и max-height: 9999px — снимают ограничение глобального
   QPushButton { min-height: 30px } выше, иначе высота не опустится < 30px.
   Шрифт задаётся здесь — не в Python, не в role="action". */
QPushButton#BtnSave {
    font-size: 12px;
    font-weight: 600;
    min-height: 0;       /* снимает глобальный min-height: 30px */
    max-height: 9999px;  /* снимает возможные max-height от других правил */
}

/* ── BtnApply (кнопка Apply Profile в EditorHeader) ──────────────────────
   То же самое что BtnSave. Размер — setFixedSize() в main_window.py. */
QPushButton#BtnApply {
    font-size: 12px;
    font-weight: 700;
    min-height: 0;
    max-height: 9999px;
}

QPushButton:hover {
    background: {LIGHT_HEX_F0F4FF};
    border-color: {LIGHT_HEX_C7D2FE};
    color: {LIGHT_HEX_1E293B};
}

QPushButton:pressed {
    background: {LIGHT_HEX_E0E7FF};
}

QPushButton[role="action"] {
    background: {LIGHT_HEX_F8FAFC};      /* action кнопки — Save, Копировать, Импорт, Экспорт */
    border-color: {LIGHT_HEX_E2E8F0};
    color: {LIGHT_HEX_475569};
    font-size: 12px;
}

QPushButton[role="action"]:hover {
    background: {LIGHT_HEX_F0F4FF};
    border-color: {LIGHT_HEX_C7D2FE};
    color: {LIGHT_HEX_1E293B};
}

QPushButton[role="primary"] {
    background: {LIGHT_HEX_E8EAF6};
    border: 1px solid {LIGHT_HEX_C5CAE9};
    color: {LIGHT_HEX_3730A3};
    font-weight: 700;
    font-size: 12px;
}

QPushButton[role="primary"]:hover {
    background: {LIGHT_HEX_D1D5F0};
    border-color: {LIGHT_HEX_9FA8DA};
}

QPushButton[role="primary"]:pressed {
    background: {LIGHT_HEX_C5CAE9};
}

QPushButton[role="delete"] {
    background: {LIGHT_HEX_FEF2F2};      /* Delete — слабо-красный фон в покое */
    border: 1px solid {LIGHT_HEX_FECACA};
    color: {LIGHT_HEX_DC2626};
    font-weight: 600;
    font-size: 12px;
}

QPushButton[role="delete"]:hover {
    background: {LIGHT_HEX_FEE2E2};
    border-color: {LIGHT_HEX_FCA5A5};
    color: {LIGHT_HEX_B91C1C};
}

QPushButton[role="delete"]:pressed {
    background: {LIGHT_HEX_FECACA};
}

QPushButton:disabled {
    background: {LIGHT_HEX_F1F5F9};
    border-color: {LIGHT_HEX_E2E8F0};
    color: {LIGHT_HEX_94A3B8};
}

/* ── SCROLLBARS ───────────────────────────────────────────────── */
QScrollBar:vertical {
    width: 5px;
    background: transparent;
    margin: 4px 1px;
}

QScrollBar::handle:vertical {
    background: {LIGHT_RGBA_15_23_42_0_12}; /* ползунок */
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: {LIGHT_RGBA_15_23_42_0_22};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ── PLACEHOLDER ──────────────────────────────────────────────── */
QLabel#Placeholder {
    font-size: 18px;
    font-weight: 300;
    color: {LIGHT_HEX_CBD5E1};           /* текст-заглушка на пустых страницах */
}

/* ── DIALOGS (QMessageBox, QDialog, QFileDialog) ──────────────── */
QDialog {
    background: {LIGHT_HEX_FFFFFF};
    color: {LIGHT_HEX_1E293B};
}

QDialog QLabel {
    color: {LIGHT_HEX_1E293B};
    font-size: 13px;
    background: transparent;
}

QMessageBox {
    background: {LIGHT_HEX_FFFFFF};
    color: {LIGHT_HEX_1E293B};
}

QMessageBox QLabel {
    color: {LIGHT_HEX_1E293B};
    font-size: 13px;
    background: transparent;
}

QMessageBox QPushButton {
    min-width: 72px;
    min-height: 32px;
    font-size: 13px;
}

/* ── WI-FI PAGE ───────────────────────────────────────────────── */
QTableWidget#WifiNetworkTable,
QTableWidget#WifiProfileTable {
    background: transparent;
    border: none;
    outline: none;
    gridline-color: transparent;
    selection-background-color: transparent;
}

QTableWidget#WifiNetworkTable::item,
QTableWidget#WifiProfileTable::item {
    padding: 4px 8px;
    border: none;
    background: transparent;
    color: {LIGHT_HEX_334155};
}

QTableWidget#WifiNetworkTable::item:selected,
QTableWidget#WifiProfileTable::item:selected {
    background: {LIGHT_HEX_EEF2FF};
    color: {LIGHT_HEX_1E293B};
    border-radius: 6px;
}

QHeaderView::section {
    background: transparent;
    color: {LIGHT_HEX_94A3B8};
    font-size: 11px;
    font-weight: 600;
    padding: 4px 8px;
    border: none;
    border-bottom: 1px solid {LIGHT_HEX_E2E8F0};
}

QFrame#WifiStatusBar {
    border-bottom: 1px solid {LIGHT_HEX_E2E8F0};
    background: transparent;
}

QLabel#WifiStatusLabel {
    font-size: 13px;
    color: {LIGHT_HEX_475569};
}

QLabel#WifiFeedback {
    font-size: 13px;
    padding: 4px 0;
}

QCheckBox {
    font-size: 13px;
    color: {LIGHT_HEX_475569};
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid {LIGHT_HEX_CBD5E1};
    background: {LIGHT_HEX_F8FAFC};
}

QCheckBox::indicator:checked {
    background: {LIGHT_HEX_6366F1};
    border-color: {LIGHT_HEX_6366F1};
}

QFrame#WifiTopPanel {
    border-bottom: 1px solid {LIGHT_HEX_E2E8F0};
}

QFrame#WifiBottomPanel {
    background: transparent;
}

/* ── WI-FI TABS ───────────────────────────────────────────────── */
QTabWidget#WifiTabs {
    border: none;
}

QTabWidget#WifiTabs::pane {
    border: none;
    background: transparent;
}

QTabWidget#WifiTabs > QTabBar::tab {
    background: transparent;
    color: {LIGHT_HEX_94A3B8};
    font-size: 13px;
    font-weight: 500;
    padding: 10px 20px;
    border: none;
    border-bottom: 2px solid transparent;
    min-width: 100px;
}

QTabWidget#WifiTabs > QTabBar::tab:selected {
    color: {LIGHT_HEX_6366F1};
    border-bottom: 2px solid {LIGHT_HEX_6366F1};
}

QTabWidget#WifiTabs > QTabBar::tab:hover:!selected {
    color: {LIGHT_HEX_475569};
    border-bottom: 2px solid {LIGHT_HEX_CBD5E1};
}

QFrame#WifiProfileToolbar {
    border-bottom: 1px solid {LIGHT_HEX_E2E8F0};
    background: transparent;
}

QFrame#WifiProfileToolbar QPushButton {
    min-height: 0;
    max-height: 9999px;
}

QLabel#WifiStatusDetails {
    font-size: 11px;
    color: {LIGHT_HEX_64748B};
    padding-left: 22px;
    background: transparent;
}

QMenu {
    background: {LIGHT_HEX_FFFFFF};
    border: 1px solid {LIGHT_HEX_E2E8F0};
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 16px;
    border-radius: 4px;
    font-size: 13px;
    color: {LIGHT_HEX_1E293B};
}
QMenu::item:selected { background: {LIGHT_HEX_EEF2FF}; color: {LIGHT_HEX_4F46E5}; }
QMenu::separator { height: 1px; background: {LIGHT_HEX_E2E8F0}; margin: 3px 8px; }

/* ── TOOLS PAGE ───────────────────────────────────────────────── */
QFrame#ToolsSidebar {
    border-right: 1px solid {LIGHT_HEX_E2E8F0};
    background: transparent;
}

/* ── Tool nav items ── */
QFrame#ToolNavItem {
    background: transparent;
    border-radius: 0;
}
QFrame#ToolNavItem:hover {
    background: {LIGHT_HEX_F1F5F9};
}
QFrame#ToolNavItem[active="true"] {
    background: {LIGHT_HEX_EEF2FF};
}

QFrame#ToolNavBar {
    background: transparent;
    border-radius: 0 2px 2px 0;
}
QFrame#ToolNavBar[active="true"] {
    background: {LIGHT_HEX_4F46E5};
}

QLabel#ToolNavIcon {
    color: {LIGHT_HEX_94A3B8};
    font-size: 13px;
}
QLabel#ToolNavIcon[active="true"] {
    color: {LIGHT_HEX_4F46E5};
}

QLabel#ToolNavText {
    color: {LIGHT_HEX_475569};
    font-size: 12px;
    padding-right: 4px;
}
QLabel#ToolNavText[active="true"] {
    color: {LIGHT_HEX_4F46E5};
    font-weight: 600;
}

QLabel#ToolGroupLabel {
    font-size: 13px;
    font-weight: 700;
    color: {LIGHT_HEX_94A3B8};
    padding-left: 14px;
    padding-top: 2px;
    padding-bottom: 2px;
}

QFrame#ToolDivider {
    background: {LIGHT_HEX_E2E8F0};
    max-height: 1px;
    margin: 0 10px;
}

QLabel#ToolPanelTitle {
    font-size: 15px;
    font-weight: 500;
    color: {LIGHT_HEX_1E293B};
}

/* Subnet Calculator */
QLabel#SubnetLabel {
    font-size: 12px;
    color: {LIGHT_HEX_64748B};
    min-width: 140px;
}
QLabel#SubnetValue {
    font-size: 12px;
    font-weight: 600;
    color: {LIGHT_HEX_1E293B};
}

/* Speed Test cards */
QFrame#SpeedCard {
    background: {LIGHT_HEX_F1F5F9};
    border: 1px solid {LIGHT_HEX_E2E8F0};
    border-radius: 10px;
}
QLabel#SpeedCardTitle {
    font-size: 11px;
    color: {LIGHT_HEX_64748B};
}
QLabel#SpeedCardValue {
    font-size: 24px;
    font-weight: 700;
    color: {LIGHT_HEX_1E293B};
}
QLabel#SpeedCardUnit {
    font-size: 11px;
    color: {LIGHT_HEX_94A3B8};
}

QTextEdit#ToolOutput {
    background: {LIGHT_HEX_FFFFFF};
    border: 1px solid {LIGHT_HEX_E2E8F0};
    border-radius: 8px;
    color: {LIGHT_HEX_1E293B};
    selection-background-color: {LIGHT_HEX_6366F1};
    selection-color: {LIGHT_HEX_FFFFFF};
    padding: 6px;
    margin-top: 10px;
}

/* Netstat / Routes / DNS Cache shared tree */
QTreeWidget#NetstatTable,
QTreeWidget#ToolTree {
    background: {LIGHT_HEX_FFFFFF};
    border: 1px solid {LIGHT_HEX_E2E8F0};
    border-radius: 8px;
    outline: none;
}
QTreeWidget#NetstatTable::item,
QTreeWidget#ToolTree::item {
    padding: 3px 6px;
    color: {LIGHT_HEX_1E293B};
}
QTreeWidget#NetstatTable::item:hover,
QTreeWidget#ToolTree::item:hover {
    background: {LIGHT_HEX_F1F5F9};
}
QTreeWidget#NetstatTable::item:selected,
QTreeWidget#NetstatTable::item:selected:active,
QTreeWidget#NetstatTable::item:selected:!active,
QTreeWidget#ToolTree::item:selected,
QTreeWidget#ToolTree::item:selected:active,
QTreeWidget#ToolTree::item:selected:!active {
    background: {LIGHT_HEX_6366F1};
    color: {LIGHT_HEX_FFFFFF};
}
QTreeWidget#NetstatTable QHeaderView::section,
QTreeWidget#ToolTree QHeaderView::section {
    background: {LIGHT_HEX_EEF2FF};
    color: {LIGHT_HEX_4F46E5};
    font-size: 11px;
    font-weight: 700;
    padding: 4px 6px;
    border: none;
    border-bottom: 1px solid {LIGHT_HEX_C7D2FE};
}

QTableWidget#NetstatTable {
    background: {LIGHT_HEX_FFFFFF};
    border: 1px solid {LIGHT_HEX_E2E8F0};
    border-radius: 8px;
    outline: none;
    gridline-color: {LIGHT_HEX_E2E8F0};
}
QTableWidget#NetstatTable::item {
    padding: 3px 6px;
    color: {LIGHT_HEX_1E293B};
    border: none;
}
QTableWidget#NetstatTable::item:hover {
    background: {LIGHT_HEX_F1F5F9};
}
QTableWidget#NetstatTable::item:selected,
QTableWidget#NetstatTable::item:selected:active,
QTableWidget#NetstatTable::item:selected:!active {
    background: {LIGHT_HEX_6366F1};
    color: {LIGHT_HEX_FFFFFF};
}
QTableWidget#NetstatTable QHeaderView::section {
    background: {LIGHT_HEX_EEF2FF};
    color: {LIGHT_HEX_4F46E5};
    font-size: 11px;
    font-weight: 700;
    padding: 4px 6px;
    border: none;
    border-bottom: 1px solid {LIGHT_HEX_C7D2FE};
    border-right: 1px solid {LIGHT_HEX_C7D2FE};
}
QTableWidget#NetstatTable QHeaderView::section:last {
    border-right: none;
}

QTreeWidget#IpconfigTree {
    background: {LIGHT_HEX_FFFFFF};
    border: 1px solid {LIGHT_HEX_E2E8F0};
    border-radius: 8px;
    alternate-background-color: {LIGHT_HEX_F1F5F9};
    margin-top: 10px;
    outline: none;
}
QTreeWidget#IpconfigTree::item {
    padding: 3px 6px;
    border: none;
    color: {LIGHT_HEX_1E293B};
}
QTreeWidget#IpconfigTree::item:hover {
    background: transparent;
}
QTreeWidget#IpconfigTree::item:hover:!selected {
    background: transparent;
    color: {LIGHT_HEX_1E293B};
}
QTreeWidget#IpconfigTree::item:selected,
QTreeWidget#IpconfigTree::item:selected:hover {
    background: {LIGHT_RGBA_99_102_241_0_12};
    color: {LIGHT_HEX_4F46E5};
}
QTreeWidget#IpconfigTree::branch {
    background: transparent;
    border: none;
}
QTreeWidget#IpconfigTree::branch:hover,
QTreeWidget#IpconfigTree::branch:selected,
QTreeWidget#IpconfigTree::branch:selected:active,
QTreeWidget#IpconfigTree::branch:hover:selected {
    background: transparent;
    border: none;
}
QTreeWidget#IpconfigTree::branch:has-children:!has-siblings:closed,
QTreeWidget#IpconfigTree::branch:has-children:has-siblings:closed {
    image: url({ASSETS}/arrow-right.svg);
    background: transparent;
}
QTreeWidget#IpconfigTree::branch:has-children:!has-siblings:open,
QTreeWidget#IpconfigTree::branch:has-children:has-siblings:open {
    image: url({ASSETS}/arrow-down.svg);
    background: transparent;
}
QTreeWidget#IpconfigTree QHeaderView::section {
    background: {LIGHT_HEX_EEF2FF};
    border: none;
    border-bottom: 1px solid {LIGHT_HEX_E2E8F0};
    border-right: 1px solid {LIGHT_HEX_E2E8F0};
    padding: 4px 8px;
    font-weight: 600;
    color: {LIGHT_HEX_475569};
}

QLabel#ToolStatus {
    font-size: 12px;
    color: {LIGHT_HEX_64748B};
}

QLineEdit#ToolInput {
    background: {LIGHT_HEX_F8FAFC};
    border: 1px solid {LIGHT_HEX_E2E8F0};
    border-radius: 6px;
    color: {LIGHT_HEX_1E293B};
    padding: 0 8px;
    font-size: 13px;
}

QLineEdit#ToolInput:focus {
    border-color: {LIGHT_HEX_6366F1};
    background: {LIGHT_HEX_FAFAFE};
}

QSpinBox#ToolSpinBox {
    background: {LIGHT_HEX_F8FAFC};
    border: 1px solid {LIGHT_HEX_E2E8F0};
    border-radius: 6px;
    color: {LIGHT_HEX_1E293B};
    padding: 0 4px;
    font-size: 13px;
}

/* ── TOOLS BUTTONS ANIMATION ──────────────────────────────────── */
QPushButton#ToolBtn {
}

QPushButton#ToolBtn:pressed {
    padding-top: 2px;
    padding-bottom: -2px;
    opacity: 0.85;
}

QPushButton#ToolBtn[role="primary"]:pressed {
    background: {LIGHT_HEX_4338CA};
    border-color: {LIGHT_HEX_3730A3};
}

QPushButton#ToolBtn[role="action"]:pressed {
    background: {LIGHT_HEX_CBD5E1};
}

QPushButton#ToolNavBtn:pressed {
    padding-top: 2px;
    background: {LIGHT_HEX_DDE2F0};
}

/* DNS type combo */
QComboBox#ToolCombo {
    background: {LIGHT_HEX_F8FAFC};
    border: 1px solid {LIGHT_HEX_E2E8F0};
    border-radius: 6px;
    color: {LIGHT_HEX_1E293B};
    padding: 0 8px;
    font-size: 13px;
    min-height: 28px;
    max-width: 180px;
}

QComboBox#ToolCombo::drop-down {
    border: none;
    width: 20px;
}

QComboBox#ToolCombo:focus {
    border-color: {LIGHT_HEX_6366F1};
}

QSpinBox#ToolSpinBox:disabled {
    color: {LIGHT_HEX_94A3B8};
    background: {LIGHT_HEX_F1F5F9};
}

QSpinBox#SettingsSpinBox {
    background: {LIGHT_HEX_F8FAFC};
    border: 1px solid {LIGHT_HEX_E2E8F0};
    border-radius: 7px;
    color: {LIGHT_HEX_1E293B};
    font-size: 13px;
    padding: 0 8px;
    min-height: 0;
    max-height: 9999px;
}

QSpinBox#SettingsSpinBox::up-button,
QSpinBox#SettingsSpinBox::down-button {
    width: 0;
    border: none;
}
/* Subnet Calculator / Калькулятор подсетей */
QFrame#SubnetInputCard,
QFrame#SubnetResultCard {
    background: {LIGHT_HEX_FFFFFF};
    border: 1px solid {LIGHT_HEX_E2E8F0};
    border-radius: 10px;
}
QLabel#SubnetInputLabel {
    color: {LIGHT_HEX_475569};
    font-size: 12px;
    font-weight: 600;
}
QLabel#SubnetResultsTitle {
    color: {LIGHT_HEX_1E293B};
    font-size: 13px;
    font-weight: 700;
}
QLabel#SubnetCardTitle {
    color: {LIGHT_HEX_4F46E5};
    font-size: 11px;
    font-weight: 700;
    padding-bottom: 5px;
    border-bottom: 1px solid {LIGHT_HEX_E2E8F0};
}
QFrame#SubnetResultCard QLabel#SubnetLabel {
    min-width: 150px;
}
/* TCP Port Scanner / Сканер TCP-портов */
QFrame#PortScanInputCard,
QFrame#PortScanResultCard {
    background: {LIGHT_HEX_FFFFFF};
    border: 1px solid {LIGHT_HEX_E2E8F0};
    border-radius: 10px;
}
QLabel#PortScanInputLabel {
    background: {LIGHT_HEX_FFFFFF};
    color: {LIGHT_HEX_475569};
    font-size: 12px;
    font-weight: 600;
}
QLabel#PortScanProgressText {
    color: {LIGHT_HEX_64748B};
    font-size: 12px;
}
QProgressBar#PortScanProgress {
    background: {LIGHT_HEX_E2E8F0};
    border: none;
    border-radius: 3px;
}
QProgressBar#PortScanProgress::chunk {
    background: {LIGHT_HEX_6366F1};
    border-radius: 3px;
}
QTableWidget#PortScanTable {
    background: {LIGHT_HEX_FFFFFF};
    alternate-background-color: {LIGHT_HEX_F8FAFC};
    color: {LIGHT_HEX_1E293B};
    border: none;
    border-radius: 10px;
}
QTableWidget#PortScanTable::item {
    padding: 7px 10px;
    border-bottom: 1px solid {LIGHT_HEX_E2E8F0};
}
QTableWidget#PortScanTable::item:selected {
    background: {LIGHT_HEX_E0E7FF};
    color: {LIGHT_HEX_1E293B};
}
QTableWidget#PortScanTable QHeaderView::section {
    background: {LIGHT_HEX_EEF2FF};
    color: {LIGHT_HEX_4F46E5};
    border: none;
    border-bottom: 1px solid {LIGHT_HEX_C7D2FE};
    padding: 8px 10px;
    font-weight: 700;
}
/* Windows DNS Cache / Кэш DNS Windows */
QFrame#DnsCacheToolbarCard,
QFrame#DnsCacheResultCard {
    background: {LIGHT_HEX_FFFFFF};
    border: 1px solid {LIGHT_HEX_E2E8F0};
    border-radius: 10px;
}
QLabel#DnsCacheToolbarLabel {
    background: {LIGHT_HEX_FFFFFF};
