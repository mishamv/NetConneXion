    border: 1px solid {LIGHT_HEX_C7D2FE};
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}
QTreeWidget#DnsCacheTable {
    background: {LIGHT_HEX_FFFFFF};
    alternate-background-color: {LIGHT_HEX_F8FAFC};
    color: {LIGHT_HEX_1E293B};
    border: none;
    border-radius: 10px;
}
QTreeWidget#DnsCacheTable::item {
    padding: 7px 10px;
    border-bottom: 1px solid {LIGHT_HEX_E2E8F0};
}
QTreeWidget#DnsCacheTable QHeaderView::section {
    background: {LIGHT_HEX_EEF2FF};
    color: {LIGHT_HEX_4F46E5};
    border: none;
    border-bottom: 1px solid {LIGHT_HEX_C7D2FE};
    padding: 8px 10px;
    font-weight: 700;
}


/* IP Batch Check structured workspace */
QFrame#IpBatchSourceCard {
    background: #ffffff;
    border: 1px solid #d8e1ee;
    border-radius: 12px;
}
QLabel#IpBatchFieldLabel {
    color: #526987;
    font-size: 12px;
    font-weight: 600;
}
QLabel#IpBatchFileLabel {
    color: #637a99;
    padding: 0 10px;
}
QLabel#IpBatchSummaryPill {
    color: #425a78;
    background: #e8eef9;
    border-radius: 11px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 600;
}
QFrame#IpBatchProgressRow {
    background: #f7f9fc;
    border: 1px solid #d8e1ee;
    border-radius: 9px;
}
QFrame#IpBatchProgressRow QLabel#ToolStatus {
    color: #637a99;
    background: transparent;
    border: none;
    font-size: 11px;
}
QProgressBar#IpBatchProgress {
    background: #e1e8f2;
    border: none;
    border-radius: 3px;
    color: transparent;
}
QProgressBar#IpBatchProgress::chunk {
    background: #6674f7;
    border-radius: 3px;
}
QTableWidget#IpBatchTable {
    background: #ffffff;
    alternate-background-color: #f5f7fb;
    color: #17243a;
    border: 1px solid #d8e1ee;
    border-radius: 10px;
    gridline-color: #e7ecf3;
}
QTableWidget#IpBatchTable::item {
    padding-left: 8px;
    padding-right: 8px;
}
QTableWidget#IpBatchTable QHeaderView::section {
    background: #edf1ff;
    color: #4338ca;
    border: none;
    border-bottom: 1px solid #cdd7ef;
    padding: 8px 12px;
    font-weight: 700;
}


/* IP Batch numeric controls */
QSpinBox#ToolSpin {
    background: #f7f9fc;
    color: #17243a;
    border: 1px solid #d8e1ee;
    border-radius: 8px;
    padding: 6px 24px 6px 10px;
    selection-background-color: #6674f7;
}
QSpinBox#ToolSpin::up-button,
QSpinBox#ToolSpin::down-button {
    width: 18px;
    background: #edf1f7;
    border: none;
}


/* Signal Monitor structured controls */
QFrame#SignalControlsCard {
    background: #ffffff;
    border: 1px solid #d8e1ee;
    border-radius: 11px;
}
QLabel#SignalConnectionBadge {
    color: #526987;
    background: #e8eef9;
    border-radius: 12px;
    padding: 5px 11px;
    font-size: 11px;
    font-weight: 600;
}
