# Normalize line endings
* text=auto eol=lf

# Python source
*.py text eol=lf

# Qt stylesheets
*.qss text eol=lf

# Docs and config
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — no line-ending conversion
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.exe binary
*.dll binary
*.pyd binary
