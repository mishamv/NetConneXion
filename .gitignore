# ──────────────────────────────────────────────────────────────
#  NetConneXion — .gitignore
# ──────────────────────────────────────────────────────────────

# ── Пользовательские данные (data/) ───────────────────────────
data/profiles.json
data/history.json
data/settings.json
data/network_mappings.json
data/wifi_profiles.json
data/wifi_options.json
data/tools_settings.json

# Логи и временные файлы
data/logs/
data/*.log
data/*.tmp
data/*.bak

# Пользовательские данные любых других форматов
data/*.db
data/*.sqlite

# ── Claude Code / AI ──────────────────────────────────────────
.claude/
.claude/**

# ── Переменные окружения и секреты ────────────────────────────
.env
.env.*
*.env
secrets.json
secrets.yaml
secrets.toml
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/
*.spec

# ── Виртуальное окружение ─────────────────────────────────────
.venv/
venv/
env/
ENV/
.python-version

# ── Логи (в корне и везде) ────────────────────────────────────
*.log
logs/

# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ── Сборка / дистрибутив ──────────────────────────────────────
*.exe
*.msi
*.zip
*.tar.gz
Output/
installer/Output/

# ── Прочее ────────────────────────────────────────────────────
nul
*.tmp
*.bak
*.bkp
*.orig
*.rej

# ── Исключения: файлы которые ДОЛЖНЫ быть в репо ──────────────
!data/locales/
!data/locales/**
!data/Full_logo.png
!data/logo_dark.png
!data/logo_light.png
