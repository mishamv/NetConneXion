)


def ensure_admin() -> None:
    """Ensure the process is running elevated on Windows.

    This app must run as Administrator to apply network settings.
    We relaunch the *same* interpreter with an absolute script path and a stable working directory.
    """
    if sys.platform != "win32":
        return

    try:
        is_admin = ctypes.windll.shell32.IsUserAnAdmin() != 0
    except Exception:
        is_admin = False

    if is_admin:
        return

    script = str(Path(sys.argv[0]).resolve())
    workdir = str(Path(script).parent)

    # Build params for python.exe: "<abs_script>" "<arg1>" "<arg2>" ...
    args = [script] + sys.argv[1:]
    params = " ".join(f'"{a}"' for a in args)
    executable = sys.executable

    try:
        result = ctypes.windll.shell32.ShellExecuteW(None, "runas", executable, params, workdir, 1)
    except Exception:
        result = 0

    # If UAC accepted, the elevated process will start; exit this one cleanly.
    if result and int(result) > 32:
        raise SystemExit(0)

    # UAC cancelled or launch failed.
    try:
        from tkinter import messagebox
        messagebox.showerror(
            "Quick IP Change",
            "Не удалось запустить приложение с правами администратора.\n"
            "Проверьте запрос UAC или запустите PowerShell/Terminal от имени администратора и выполните: python app_ctk.py",
        )
    except Exception:
        pass
    raise SystemExit(1)


class QuickIPChangeCTK(ctk.CTk if ctk is not None else tk.Tk):
    def __init__(self) -> None:
        super().__init__()

        ctk.set_appearance_mode("light")
        ctk.set_default_color_theme("blue")

        self.title("Quick IP Change")
        self.geometry("1320x820")
        self.configure(fg_color="#F4F6F9")

        self.adapters = list_network_adapters()
        self.profiles: dict[str, NetworkProfile] = load_profiles()
        self.settings: dict = load_settings()

        # i18n
        if _HAS_I18N:
            import pathlib
            _locales = str(pathlib.Path(__file__).parent / "data" / "locales")
            _lang = self.settings.get("language", "ru")
            self.i18n = _I18nService(locales_dir=_locales, default_locale=_lang)
        else:
            self.i18n = None
        self.current_profile_key: str | None = next(iter(self.profiles.keys()), None)
        self.theme_var = tk.BooleanVar(value=str(self.settings.get("ui_theme", "light")).lower() == "dark")
        self.theme_mode = "dark" if self.theme_var.get() else "light"
        self.colors = self._theme_palette(self.theme_mode)
        ctk.set_appearance_mode(self.theme_mode)

        self.dhcp_ip = tk.BooleanVar(value=False)
        self.dhcp_dns = tk.BooleanVar(value=False)
        self.wifi_auto_apply_var = tk.BooleanVar(value=bool(self.settings.get("wifi_auto_apply", False)))
        self._last_seen_ssid: str | None = None
        self._last_auto_applied_ssid: str | None = None

        self.profile_search_var = tk.StringVar(value="")
        self.profile_adapter_filter_var = tk.StringVar(value="Все адаптеры")
        self.history_status_filter_var = tk.StringVar(value="Все")
        self.history_search_var = tk.StringVar(value="")

        self._build_shell()
        self._apply_theme_ui()
        self._refresh_profiles(select=self.current_profile_key)
        self._update_home_snapshot()
        self._schedule_auto_switch_check()

    def _theme_palette(self, mode: str) -> dict[str, str]:
        # Центральные цветовые токены темы.
        # Редактируйте только здесь, чтобы поменять цвета во всём UI:
        # - primary/hover: верхняя панель и навигация
        # - card/bg: фон секций и карточек
        # - input_bg/border/text: поля ввода и комбобоксы
        # - combo_button: зона стрелки выпадающего списка
        if mode == "dark":
            return {
                "primary": "#1E3A6A",
                "hover": "#2A4E85",
                "accent": "#4F86E8",
                "bg": "#111827",
                "card": "#1F2937",
                "border": "#374151",
                "text": "#E5E7EB",
                "text_secondary": "#94A3B8",
                "input_bg": "#1F2937",
                "list_bg": "#1F2937",
                "combo_button": "#475569",
                "combo_button_hover": "#64748B",
            }
        return {
            "primary": "#2F5D9F",
            "hover": "#3C6FC0",
            "accent": "#4F86E8",
            "bg": "#F4F6F9",
            "card": "#FFFFFF",
            "border": "#D9DEE7",
            "text": "#1F2937",
            "text_secondary": "#6B7280",
            "input_bg": "#FFFFFF",
            "list_bg": "#FFFFFF",
            "combo_button": "#CBD5E1",
            "combo_button_hover": "#94A3B8",
        }

    def _retheme_labels_recursive(self, parent: tk.Widget, text_color: str) -> None:
        for child in parent.winfo_children():
            if ctk is not None and isinstance(child, ctk.CTkLabel):
                try:
                    child.configure(text_color=text_color)
                except Exception:
                    pass
            self._retheme_labels_recursive(child, text_color)

    def _apply_theme_ui(self) -> None:
        self.configure(fg_color=self.colors["bg"])
        if hasattr(self, "content"):
            self.content.configure(fg_color=self.colors["bg"])
        if hasattr(self, "sidebar"):
            self.sidebar.configure(fg_color=self.colors["primary"])
        if hasattr(self, "topbar"):
            self.topbar.configure(fg_color=self.colors["primary"])
        if hasattr(self, "section_frames"):
            if "dashboard" in self.section_frames:
                self.section_frames["dashboard"].configure(fg_color=self.colors["card"])
                self._retheme_labels_recursive(self.section_frames["dashboard"], self.colors["text"])
            if "network" in self.section_frames:
                self.section_frames["network"].configure(fg_color=self.colors["bg"])
                self._retheme_labels_recursive(self.section_frames["network"], self.colors["text"])
            if "wifi" in self.section_frames:
                self.section_frames["wifi"].configure(fg_color=self.colors["card"])
                self._retheme_labels_recursive(self.section_frames["wifi"], self.colors["text"])
            if "history" in self.section_frames:
                self.section_frames["history"].configure(fg_color=self.colors["card"])
                self._retheme_labels_recursive(self.section_frames["history"], self.colors["text"])
            if "tools" in self.section_frames:
                self.section_frames["tools"].configure(fg_color=self.colors["card"])
                self._retheme_labels_recursive(self.section_frames["tools"], self.colors["text"])

        for attr in ["profiles_card", "network_card", "wifi_left_card", "wifi_mappings_holder"]:
            if hasattr(self, attr):
                getattr(self, attr).configure(fg_color=self.colors["card"], border_color=self.colors["border"])

        for attr in ["wifi_title_label", "wifi_visible_title_label", "current_ssid_label", "wifi_auto_status_label"]:
            if hasattr(self, attr):
                color = self.colors["text"] if attr in {"wifi_title_label", "wifi_visible_title_label"} else self.colors["text_secondary"]
                getattr(self, attr).configure(text_color=color)

        if hasattr(self, "wifi_delete_button"):
            if self.theme_mode == "dark":
                self.wifi_delete_button.configure(fg_color="#1E40AF", hover_color="#1D4ED8", text_color="#E5E7EB", border_width=0)
            else:
                self.wifi_delete_button.configure(fg_color="#3B82F6", hover_color="#2563EB", text_color="#FFFFFF", border_width=0)

        # Выпадающие списки (цвет поля + цвет кнопки-стрелки).
        # Если нужно поправить вид combobox, меняйте параметры в этом блоке.
        for attr in ["adapter_combo", "profile_adapter_filter", "wifi_profile_combo", "history_status_combo"]:
            if hasattr(self, attr):
                getattr(self, attr).configure(
                    fg_color=self.colors["input_bg"],
                    border_color=self.colors["border"],
                    button_color=self.colors["combo_button"],
                    button_hover_color=self.colors["combo_button_hover"],
                    dropdown_fg_color=self.colors["card"],
                    dropdown_text_color=self.colors["text"],
                    text_color=self.colors["text"],
                    text_color_disabled=self.colors["text"],
                )

        for attr in ["profile_list", "wifi_visible_list", "wifi_mappings_list"]:
            if hasattr(self, attr):
                getattr(self, attr).configure(
                    bg=self.colors["list_bg"],
                    fg=self.colors["text"],
                    selectbackground=self.colors["accent"],
                    selectforeground="#FFFFFF",
                )

        for attr in ["profile_scroll", "wifi_visible_scroll", "wifi_mappings_scroll"]:
            if hasattr(self, attr):
                getattr(self, attr).configure(
                    fg_color=self.colors["card"],
                    button_color=self.colors["combo_button"],
                    button_hover_color=self.colors["combo_button_hover"],
                )

        # Все текстовые поля/поиск/поля профиля (единый стиль ввода).
        for attr in [
            "profile_search_entry", "history_search_entry", "tools_target", "wifi_ssid_entry",
            "wifi_alias_entry", "wifi_user_entry", "profile_name", "ip", "mask", "gateway", "dns1", "dns2",
        ]:
            if hasattr(self, attr):
                getattr(self, attr).configure(
                    fg_color=self.colors["input_bg"],
                    text_color=self.colors["text"],
                    border_color=self.colors["border"],
                )

        if hasattr(self, "btn_save"):
            self.btn_save.configure(fg_color="#2563EB", hover_color="#1D4ED8", text_color="#FFFFFF", border_width=0)

        if hasattr(self, "profile_action_buttons"):
            for btn in self.profile_action_buttons:
                if self.theme_mode == "dark":
                    btn.configure(
                        fg_color="#334155",
                        hover_color="#475569",
                        text_color="#E5E7EB",
                        border_color="#475569",
                    )
                else:
                    btn.configure(
                        fg_color="#FFFFFF",
                        hover_color="#EEF2F7",
                        text_color=self.colors["text"],
                        border_color=self.colors["border"],
                    )

        if hasattr(self, "network_tabs"):
            if self.theme_mode == "dark":
                self.network_tabs.configure(
                    fg_color=self.colors["card"],
                    segmented_button_fg_color="#334155",
                    segmented_button_selected_color="#1E293B",
                    segmented_button_selected_hover_color="#334155",
                    segmented_button_unselected_color="#334155",
                    segmented_button_unselected_hover_color="#475569",
                    text_color=self.colors["text"],
                    text_color_disabled=self.colors["text_secondary"],
                )
            else:
                self.network_tabs.configure(
                    fg_color=self.colors["card"],
                    segmented_button_fg_color="#DDE3EC",
                    segmented_button_selected_color="#FFFFFF",
                    segmented_button_selected_hover_color="#F8FAFC",
                    segmented_button_unselected_color="#DDE3EC",
                    segmented_button_unselected_hover_color="#CFD8E3",
                    text_color="#334155",
                    text_color_disabled="#94A3B8",
                )
            for tab_name in ["Профиль", "Текущая сеть"]:
                try:
                    self.network_tabs.tab(tab_name).configure(fg_color=self.colors["card"])
                except Exception:
                    pass

    def _set_theme(self, mode: str, persist: bool = True) -> None:
        self.theme_mode = mode
        self.colors = self._theme_palette(mode)
        ctk.set_appearance_mode(mode)
        self._apply_theme_ui()
        if persist:
            self.settings["ui_theme"] = mode
            save_settings(self.settings)

    def _build_shell(self) -> None:
        self.grid_columnconfigure(1, weight=1)
        self.grid_rowconfigure(1, weight=1)

        self.sidebar = ctk.CTkFrame(self, width=76, fg_color=self.colors["primary"], corner_radius=0)
        self.sidebar.grid(row=0, column=0, rowspan=2, sticky="nsew")
        self.sidebar.grid_propagate(False)

        self.topbar = ctk.CTkFrame(self, fg_color=self.colors["primary"], corner_radius=0, height=56)
        self.topbar.grid(row=0, column=1, sticky="ew")
        self.topbar.grid_columnconfigure(0, weight=1)

        # Title block (section title).
        self.title_block = ctk.CTkFrame(self.topbar, fg_color="transparent")
        self.title_block.grid(row=0, column=0, padx=16, pady=8, sticky="w")
        self.title_block.grid_rowconfigure(0, weight=0)
        self.title_block.grid_rowconfigure(1, weight=0)

        self.section_title = ctk.CTkLabel(
            self.title_block,
            text="Сеть",
            text_color="white",
            font=ctk.CTkFont(size=20, weight="bold"),
        )
        self.section_title.grid(row=0, column=0, sticky="w")


        self.content = ctk.CTkFrame(self, fg_color=self.colors["bg"], corner_radius=0)
        self.content.grid(row=1, column=1, sticky="nsew", padx=12, pady=12)
        self.content.grid_columnconfigure(0, weight=1)
        self.content.grid_rowconfigure(0, weight=1)

        self.section_frames: dict[str, tk.Widget] = {}
        self.section_frames["dashboard"] = ctk.CTkFrame(self.content, fg_color=self.colors["card"], corner_radius=8)
        self.section_frames["network"] = ctk.CTkFrame(self.content, fg_color=self.colors["bg"], corner_radius=0)
        self.section_frames["wifi"] = ctk.CTkFrame(self.content, fg_color=self.colors["card"], corner_radius=8)
        self.section_frames["history"] = ctk.CTkFrame(self.content, fg_color=self.colors["card"], corner_radius=8)
        self.section_frames["tools"] = ctk.CTkFrame(self.content, fg_color=self.colors["card"], corner_radius=8)
        self.section_frames["settings"] = ctk.CTkFrame(self.content, fg_color=self.colors["card"], corner_radius=8)

        self.nav_buttons: dict[str, tk.Widget] = {}
        nav = [
            ("dashboard", "🏠"),
            ("network", "🌐"),
            ("wifi", "📶"),
            ("history", "📜"),
            ("tools", "🛠"),
            ("settings", "⚙️"),
        ]
        for idx, (key, icon) in enumerate(nav):
            btn = ctk.CTkButton(
                self.sidebar,
                text=icon,
                width=64,
                height=56,
                fg_color="transparent",
                hover_color=self.colors["hover"],
                corner_radius=0,
                command=lambda s=key: self._switch_section(s),
                font=ctk.CTkFont(size=22),
            )
            btn.grid(row=idx, column=0, padx=6, pady=2)
            self.nav_buttons[key] = btn

        self._build_dashboard(self.section_frames["dashboard"])
        self._build_network_module(self.section_frames["network"])
        self._build_wifi_section(self.section_frames["wifi"])
        self._build_history_section(self.section_frames["history"])
        self._build_tools_section(self.section_frames["tools"])
        self._build_settings_section(self.section_frames["settings"])

        self._switch_section("network")

    def _build_dashboard(self, parent: tk.Widget) -> None:
        top = ctk.CTkFrame(parent, fg_color="transparent")
        top.pack(fill="x", padx=16, pady=(16, 10))
        lbl = ctk.CTkLabel(top, text="Dashboard", font=ctk.CTkFont(size=18, weight="bold"), text_color=self.colors["text"])
        lbl.pack(side="left")

        ctk.CTkSwitch(
            top,
            text="Темная тема",
            variable=self.theme_var,
            onvalue=True,
            offvalue=False,
            command=self._toggle_theme,
        ).pack(side="right")

        self.home_text = ctk.CTkTextbox(parent)
        self.home_text.pack(fill="both", expand=True, padx=16, pady=(0, 16))

    def _toggle_theme(self) -> None:
        mode = "dark" if self.theme_var.get() else "light"
        self._set_theme(mode, persist=True)

    def _build_wifi_section(self, parent: tk.Widget) -> None:
        self.wifi_title_label = ctk.CTkLabel(parent, text="Wi-Fi сети и привязки", text_color=self.colors["text"], font=ctk.CTkFont(size=20, weight="bold"))
        self.wifi_title_label.pack(anchor="w", padx=16, pady=(16, 8))

        top = ctk.CTkFrame(parent, fg_color="transparent")
        top.pack(fill="both", expand=True, padx=16, pady=(0, 8))
        top.grid_columnconfigure(0, weight=1)
        top.grid_columnconfigure(1, weight=1)
        top.grid_rowconfigure(1, weight=1)

        self.wifi_left_card = ctk.CTkFrame(top, fg_color=self.colors["card"], corner_radius=8, border_width=1, border_color=self.colors["border"])
        self.wifi_left_card.grid(row=0, column=0, rowspan=2, sticky="nsew", padx=(0, 8))
        self.wifi_visible_title_label = ctk.CTkLabel(self.wifi_left_card, text="Видимые Wi‑Fi сети", text_color=self.colors["text"], font=ctk.CTkFont(size=14, weight="bold"))
        self.wifi_visible_title_label.pack(anchor="w", padx=10, pady=(10, 6))
        visible_holder = ctk.CTkFrame(self.wifi_left_card, fg_color="transparent")
        visible_holder.pack(fill="both", expand=True, padx=10, pady=(0, 10))
        self.wifi_visible_list = tk.Listbox(
            visible_holder,
            bg=self.colors["list_bg"],
            fg=self.colors["text"],
            selectbackground=self.colors["accent"],
            selectforeground="#FFFFFF",
            font=("Segoe UI", 12),
            relief="flat",
            borderwidth=0,
            highlightthickness=0,
            exportselection=False,
        )
        self.wifi_visible_list.pack(side="left", fill="both", expand=True)
        self.wifi_visible_scroll = ctk.CTkScrollbar(visible_holder, orientation="vertical", command=self.wifi_visible_list.yview)
        self.wifi_visible_list.configure(yscrollcommand=self.wifi_visible_scroll.set)
        self.wifi_visible_scroll.pack(side="right", fill="y")
        self.wifi_visible_list.bind("<<ListboxSelect>>", self._on_select_visible_wifi)

        right_row = ctk.CTkFrame(top, fg_color="transparent")
        right_row.grid(row=0, column=1, sticky="ew")
        right_row.grid_columnconfigure(0, weight=1)

        self.wifi_ssid_entry = ctk.CTkEntry(right_row, placeholder_text="SSID", height=34, corner_radius=6, border_color=self.colors["border"], fg_color=self.colors["input_bg"], text_color=self.colors["text"])
        self.wifi_ssid_entry.grid(row=0, column=0, sticky="ew", padx=(0, 8))

        self.wifi_profile_combo = ctk.CTkComboBox(
            right_row,
            state="readonly",
            values=list(self.profiles.keys()) if self.profiles else [""],
            width=220,
            height=34,
            corner_radius=6,
            border_color=self.colors["border"],
            fg_color=self.colors["input_bg"],
            button_color=self.colors["combo_button"],
            button_hover_color=self.colors["combo_button_hover"],
            dropdown_fg_color=self.colors["card"],
            dropdown_hover_color="#EFF6FF",
            dropdown_text_color=self.colors["text"],
            text_color=self.colors["text"],
            text_color_disabled=self.colors["text"],
        )
        self.wifi_profile_combo.grid(row=0, column=1, padx=(0, 8))
        if self.profiles:
            self.wifi_profile_combo.set(next(iter(self.profiles.keys())))

        self.wifi_alias_entry = ctk.CTkEntry(right_row, placeholder_text="Название подключения", width=180, height=34, corner_radius=6, border_color=self.colors["border"], fg_color=self.colors["input_bg"], text_color=self.colors["text"])
        self.wifi_alias_entry.grid(row=0, column=2, padx=(0, 8))
        self.wifi_user_entry = ctk.CTkEntry(right_row, placeholder_text="Пользователь", width=160, height=34, corner_radius=6, border_color=self.colors["border"], fg_color=self.colors["input_bg"], text_color=self.colors["text"])
        self.wifi_user_entry.grid(row=0, column=3, padx=(0, 8))
        self.wifi_mapping_auto_var = tk.BooleanVar(value=True)
        ctk.CTkCheckBox(right_row, text="Авто", variable=self.wifi_mapping_auto_var).grid(row=0, column=4, padx=(0, 8))

        ctk.CTkButton(right_row, text="Добавить", command=self._add_wifi_mapping, height=34).grid(row=0, column=5)

        action_row = ctk.CTkFrame(top, fg_color="transparent")
        action_row.grid(row=1, column=1, sticky="nsew", pady=(8, 0))
        action_row.grid_rowconfigure(1, weight=1)
        action_row.grid_columnconfigure(0, weight=1)

        top_actions = ctk.CTkFrame(action_row, fg_color="transparent")
        top_actions.grid(row=0, column=0, sticky="ew", pady=(0, 8))
        self.current_ssid_label = ctk.CTkLabel(top_actions, text="Текущий SSID: -", text_color=self.colors["text_secondary"])
        self.current_ssid_label.pack(side="left")
        self.wifi_auto_apply_check = ctk.CTkCheckBox(top_actions, text="Автоприменение по SSID", variable=self.wifi_auto_apply_var, command=self._toggle_wifi_auto_apply)
        self.wifi_auto_apply_check.pack(side="left", padx=(12, 0))
        ctk.CTkButton(top_actions, text="Применить выбранную привязку", command=self._apply_selected_wifi_mapping, height=34).pack(side="right")
        ctk.CTkButton(top_actions, text="Обновить SSID", command=self._refresh_current_ssid, height=34).pack(side="right", padx=(0, 8))
        ctk.CTkButton(top_actions, text="Обновить сети", command=self._refresh_visible_wifi_list, height=34).pack(side="right", padx=(0, 8))

        self.wifi_auto_status_label = ctk.CTkLabel(action_row, text="Автоприменение: ожидание", text_color=self.colors["text_secondary"])
        self.wifi_auto_status_label.grid(row=1, column=0, sticky="w", pady=(0, 6))

        self.wifi_mappings_holder = ctk.CTkFrame(action_row, fg_color=self.colors["card"], corner_radius=8, border_width=1, border_color=self.colors["border"])
        self.wifi_mappings_holder.grid(row=2, column=0, sticky="nsew")
        self.wifi_mappings_list = tk.Listbox(
            self.wifi_mappings_holder,
            bg=self.colors["list_bg"],
            fg=self.colors["text"],
            selectbackground=self.colors["accent"],
            selectforeground="#FFFFFF",
            font=("Segoe UI", 12),
            relief="flat",
            borderwidth=0,
            highlightthickness=0,
            exportselection=False,
        )
        self.wifi_mappings_list.pack(side="left", fill="both", expand=True, padx=(8, 0), pady=8)
        self.wifi_mappings_scroll = ctk.CTkScrollbar(self.wifi_mappings_holder, orientation="vertical", command=self.wifi_mappings_list.yview)
        self.wifi_mappings_list.configure(yscrollcommand=self.wifi_mappings_scroll.set)
        self.wifi_mappings_scroll.pack(side="right", fill="y", padx=8, pady=8)

        self.wifi_delete_button = ctk.CTkButton(parent, text="Удалить выбранную", command=self._remove_wifi_mapping, height=34)
        self.wifi_delete_button.pack(anchor="w", padx=16, pady=(0, 16))

        self._refresh_wifi_mappings_list()
        self._refresh_current_ssid()
        self._refresh_visible_wifi_list()
        self._toggle_wifi_auto_apply()

    def _build_history_section(self, parent: tk.Widget) -> None:
        top = ctk.CTkFrame(parent, fg_color="transparent")
        top.pack(fill="x", padx=16, pady=(16, 8))
        ctk.CTkLabel(top, text="История применений", text_color=self.colors["text"], font=ctk.CTkFont(size=20, weight="bold")).pack(side="left")
        ctk.CTkButton(top, text="Обновить", command=self._refresh_history_panel, height=34).pack(side="right")
        ctk.CTkButton(top, text="Откатить последний", command=self._rollback_last_history_apply, height=34).pack(side="right", padx=(0, 8))

        controls = ctk.CTkFrame(parent, fg_color="transparent")
        controls.pack(fill="x", padx=16, pady=(0, 8))
        self.history_search_entry = ctk.CTkEntry(
            controls,
            textvariable=self.history_search_var,
            placeholder_text="Поиск по имени профиля...",
            height=32,
            corner_radius=6,
            border_color=self.colors["border"],
            fg_color=self.colors["input_bg"],
            text_color=self.colors["text"],
        )
        self.history_search_entry.pack(side="left", fill="x", expand=True, padx=(0, 8))
        self.history_search_entry.bind("<KeyRelease>", lambda _e: self._refresh_history_panel())

        # Поле-фильтр истории (должно выглядеть как поле поиска рядом).
        self.history_status_combo = ctk.CTkComboBox(
            controls,
            state="readonly",
            values=["Все", "Успешные", "Ошибки"],
            variable=self.history_status_filter_var,
            width=170,
            height=32,
            corner_radius=6,
            border_color=self.colors["border"],
            fg_color=self.colors["input_bg"],
            button_color=self.colors["combo_button"],
            button_hover_color=self.colors["combo_button_hover"],
            dropdown_fg_color=self.colors["card"],
            dropdown_hover_color="#EFF6FF",
            dropdown_text_color=self.colors["text"],
            text_color=self.colors["text"],
            text_color_disabled=self.colors["text"],
            command=lambda _v: self._refresh_history_panel(),
        )
        self.history_status_combo.pack(side="left")

        self.history_stats_label = ctk.CTkLabel(parent, text="Статистика: -", text_color=self.colors["text_secondary"])
        self.history_stats_label.pack(anchor="w", padx=16, pady=(0, 6))

        self.history_text = ctk.CTkTextbox(parent, font=ctk.CTkFont(family="Consolas", size=12))
        self.history_text.pack(fill="both", expand=True, padx=16, pady=(0, 16))
        self._refresh_history_panel()

    def _build_tools_section(self, parent: tk.Widget) -> None:
        ctk.CTkLabel(parent, text="Сетевые инструменты", text_color=self.colors["text"], font=ctk.CTkFont(size=20, weight="bold")).pack(anchor="w", padx=16, pady=(16, 8))

        top = ctk.CTkFrame(parent, fg_color="transparent")
        top.pack(fill="x", padx=16, pady=(0, 8))
        ctk.CTkLabel(top, text="Host/DNS", text_color=self.colors["text"]).pack(side="left", padx=(0, 8))
        self.tools_target = ctk.CTkEntry(top, height=34, corner_radius=6, border_color=self.colors["border"], fg_color=self.colors["input_bg"], text_color=self.colors["text"])
        self.tools_target.pack(side="left", fill="x", expand=True)
        self.tools_target.insert(0, "8.8.8.8")

        buttons = ctk.CTkFrame(parent, fg_color="transparent")
        buttons.pack(fill="x", padx=16, pady=(0, 8))
        for text, tool in [("Ping", "ping"), ("DNS check", "dns"), ("Netstat", "netstat"), ("Flush DNS", "flushdns"), ("TCP/IP reset", "tcpreset")]:
            ctk.CTkButton(buttons, text=text, height=34, command=lambda t=tool: self._run_tool(t)).pack(side="left", padx=(0, 6))

        self.tools_output = ctk.CTkTextbox(parent, font=ctk.CTkFont(family="Consolas", size=12))
        self.tools_output.pack(fill="both", expand=True, padx=16, pady=(0, 16))

    def _build_network_module(self, parent: tk.Widget) -> None:
        parent.grid_columnconfigure(0, minsize=360, weight=0)
        parent.grid_columnconfigure(1, weight=1)
        parent.grid_rowconfigure(0, weight=1)

        self.profiles_card = ctk.CTkFrame(parent, fg_color=self.colors["card"], corner_radius=8, border_width=1, border_color=self.colors["border"])
        self.profiles_card.grid(row=0, column=0, sticky="nsew", padx=(0, 8))
        self.profiles_card.grid_columnconfigure(0, weight=1)

        ctk.CTkLabel(self.profiles_card, text="Профили", text_color=self.colors["text"], font=ctk.CTkFont(size=16, weight="bold")).pack(
            anchor="w", padx=12, pady=(12, 4)
        )
        ctk.CTkFrame(self.profiles_card, fg_color=self.colors["border"], height=1).pack(fill="x", padx=12, pady=(0, 10))

        search_row = ctk.CTkFrame(self.profiles_card, fg_color="transparent")
        search_row.pack(fill="x", padx=12, pady=(0, 8))
        self.profile_search_entry = ctk.CTkEntry(
            search_row,
            textvariable=self.profile_search_var,
            placeholder_text="Поиск профиля...",
            height=32,
            corner_radius=6,
            border_color=self.colors["border"],
            fg_color=self.colors["input_bg"],
            text_color=self.colors["text"],
        )
        self.profile_search_entry.pack(fill="x")
        self.profile_search_entry.bind("<KeyRelease>", lambda _e: self._refresh_profiles(select=self.current_profile_key))

        self.profile_adapter_filter = ctk.CTkComboBox(
            self.profiles_card,
            state="readonly",
            values=["Все адаптеры"],
            variable=self.profile_adapter_filter_var,
            height=32,
            corner_radius=6,
            border_color=self.colors["border"],
            fg_color=self.colors["input_bg"],
            button_color=self.colors["combo_button"],
            button_hover_color=self.colors["combo_button_hover"],
            dropdown_fg_color=self.colors["card"],
            dropdown_hover_color="#EFF6FF",
            dropdown_text_color=self.colors["text"],
            text_color=self.colors["text"],
            text_color_disabled=self.colors["text"],
            command=lambda _v: self._refresh_profiles(select=self.current_profile_key),
        )
        self.profile_adapter_filter.pack(fill="x", padx=12, pady=(0, 10))

        list_holder = ctk.CTkFrame(self.profiles_card, fg_color=self.colors["card"], corner_radius=6, border_width=1, border_color=self.colors["border"])
        list_holder.pack(fill="both", expand=True, padx=12, pady=(0, 12))

        self.profile_list = tk.Listbox(
            list_holder,
            bg=self.colors["list_bg"],
            fg=self.colors["text"],
            selectbackground=self.colors["accent"],
            selectforeground="#FFFFFF",
            font=("Segoe UI", 15),
            relief="flat",
            borderwidth=0,
            highlightthickness=0,
            exportselection=False,
        )
        self.profile_scroll = ctk.CTkScrollbar(list_holder, orientation="vertical", command=self.profile_list.yview)
        self.profile_list.configure(yscrollcommand=self.profile_scroll.set)
        self.profile_list.pack(side="left", fill="both", expand=True)
        self.profile_scroll.pack(side="right", fill="y")
        self.profile_list.bind("<<ListboxSelect>>", self._on_select_profile)

        self.profile_action_buttons: list[tk.Widget] = []
        profile_actions = [
            ("+ Новый", self._create_profile),
            ("Удалить", self._delete_profile),
            ("Экспорт", self._export_profiles),
            ("Импорт", self._import_profiles),
            ("Дублировать", self._duplicate_profile),
        ]
        # Левые кнопки управления профилями (+Новый/Удалить/Экспорт/Импорт/Дублировать).
        for idx, (txt, cmd) in enumerate(profile_actions):
            pady = (4, 14) if idx == len(profile_actions) - 1 else 4
            btn = ctk.CTkButton(
                self.profiles_card,
                text=txt,
                fg_color=self.colors["card"],
                text_color=self.colors["text"],
                text_color_disabled=self.colors["text_secondary"],
                hover_color="#EEF2F7",
                border_width=1,
                border_color=self.colors["border"],
                corner_radius=6,
                command=cmd,
                height=34,
            )
            btn.pack(fill="x", padx=12, pady=pady)
            self.profile_action_buttons.append(btn)

        self.network_card = ctk.CTkFrame(parent, fg_color=self.colors["card"], corner_radius=8, border_width=1, border_color=self.colors["border"])
        self.network_card.grid(row=0, column=1, sticky="nsew")
        self.network_card.grid_columnconfigure(0, weight=1)
        self.network_card.grid_rowconfigure(1, weight=1)

        self.network_card.grid_columnconfigure(1, weight=0)

        self.network_actions = ctk.CTkFrame(self.network_card, fg_color="transparent")
        self.network_actions.grid(row=0, column=0, columnspan=2, sticky="e", padx=(0, 12), pady=(16, 8))

        # Кнопка: «Применить профиль» (primary-акцент).
        self.btn_apply = ctk.CTkButton(
            self.network_actions,
            text="Применить профиль",
            fg_color="#2563EB",
            hover_color="#1D4ED8",
            text_color="#FFFFFF",
            corner_radius=10,
            border_width=0,
            command=self._apply_current,
            width=190,
            height=40,
            font=ctk.CTkFont(size=14, weight="bold"),
        )
        self.btn_apply.pack(side="left", padx=(0, 8))

        # Кнопка: «Сохранить» (сейчас тоже акцентная синяя для контраста).
        self.btn_save = ctk.CTkButton(
            self.network_actions,
            text="Сохранить",
            fg_color="#2563EB",
            text_color="#FFFFFF",
            hover_color="#1D4ED8",
            border_width=0,
            border_color="#2563EB",
            corner_radius=10,
            command=self._save_current_profile,
            width=150,
            height=40,
            font=ctk.CTkFont(size=14, weight="bold"),
        )
        self.btn_save.pack(side="left")

        self.network_tabs = ctk.CTkTabview(
            self.network_card,
            fg_color=self.colors["card"],
            segmented_button_fg_color="#DDE3EC",
            segmented_button_selected_color="#FFFFFF",
            segmented_button_selected_hover_color="#F8FAFC",
            segmented_button_unselected_color="#DDE3EC",
            segmented_button_unselected_hover_color="#CFD8E3",
            text_color="#334155",
            text_color_disabled="#94A3B8",
        )
        self.network_tabs.grid(row=1, column=0, columnspan=2, sticky="nsew", padx=10, pady=(0, 10))
        self.network_tabs.add("Профиль")
        self.network_tabs.add("Текущая сеть")

        self._build_network_profile_tab(self.network_tabs.tab("Профиль"))
        self._build_network_current_tab(self.network_tabs.tab("Текущая сеть"))
        self.network_tabs.set("Профиль")

        segmented = getattr(self.network_tabs, "_segmented_button", None)
        if segmented is not None:
            segmented.configure(font=ctk.CTkFont(size=14, weight="bold"), text_color="#334155", text_color_disabled="#94A3B8")

    def _build_network_profile_tab(self, tab: tk.Widget) -> None:
        tab.grid_columnconfigure(1, weight=1)

        self.profile_name = self._entry_field(tab, "Профиль", 0)

        ctk.CTkLabel(tab, text="Сетевой адаптер", text_color=self.colors["text"], font=ctk.CTkFont(size=13)).grid(row=1, column=0, sticky="w", padx=(14, 8), pady=6)
        adapter_values = self.adapters if self.adapters else [""]
        # Поле: «Сетевой адаптер» (выпадающий список).
        # Цвет стрелки/кнопки задаётся через button_color / button_hover_color.
        self.adapter_combo = ctk.CTkComboBox(
            tab,
            state="readonly",
            values=adapter_values,
            font=ctk.CTkFont(family="Segoe UI", size=15),
            dropdown_font=ctk.CTkFont(family="Segoe UI", size=14),
            height=34,
            corner_radius=6,
            border_width=1,
            border_color="#D1D5DB",
            fg_color=self.colors["input_bg"],
            text_color=self.colors["text"],
            button_color=self.colors["combo_button"],
            button_hover_color=self.colors["combo_button_hover"],
            dropdown_fg_color=self.colors["card"],
            dropdown_text_color=self.colors["text"],
            dropdown_hover_color="#EFF6FF",
            text_color_disabled=self.colors["text"],
            command=lambda _choice: self._update_summary(),
        )
        self.adapter_combo.grid(row=1, column=1, sticky="ew", padx=(0, 14), pady=6)
        self.adapter_combo.bind("<Button-1>", self._open_adapter_dropdown, add="+")

        ctk.CTkCheckBox(tab, text="Получать IP автоматически (DHCP)", variable=self.dhcp_ip, command=self._toggle_state).grid(row=2, column=0, columnspan=2, sticky="w", padx=14, pady=(8, 4))
        self.ip = self._entry_field(tab, "IP адрес", 3)
        self.mask = self._entry_field(tab, "Маска подсети", 4)
        self.gateway = self._entry_field(tab, "Шлюз", 5)

        ctk.CTkCheckBox(tab, text="Получать DNS автоматически", variable=self.dhcp_dns, command=self._toggle_state).grid(row=6, column=0, columnspan=2, sticky="w", padx=14, pady=(12, 4))
        self.dns1 = self._entry_field(tab, "DNS основной", 7)
        self.dns2 = self._entry_field(tab, "DNS альтернативный", 8)

    def _open_adapter_dropdown(self, _: object = None) -> None:
        if hasattr(self, "adapter_combo") and hasattr(self.adapter_combo, "_clicked"):
            self.after(1, self.adapter_combo._clicked)

    def _build_network_summary_tab(self, tab: tk.Widget) -> None:
        tab.grid_rowconfigure(0, weight=1)
        tab.grid_columnconfigure(0, weight=1)
        self.summary_text = ctk.CTkTextbox(tab)
        self.summary_text.grid(row=0, column=0, sticky="nsew", padx=8, pady=8)

    def _build_network_current_tab(self, tab: tk.Widget) -> None:
        tab.grid_rowconfigure(2, weight=1)
        tab.grid_columnconfigure(0, weight=1)

        ctk.CTkLabel(
            tab,
            text="Текущее состояние сети (ipconfig /all)",
            text_color=self.colors["text"],
            font=ctk.CTkFont(size=14, weight="bold"),
        ).grid(row=0, column=0, sticky="w", padx=10, pady=(8, 2))

        ctk.CTkButton(tab, text="Обновить данные", command=self._update_home_snapshot).grid(row=1, column=0, sticky="e", padx=8, pady=(0, 8))
        self.network_info_text = ctk.CTkTextbox(tab, font=ctk.CTkFont(family="Consolas", size=12))
        self.network_info_text.grid(row=2, column=0, sticky="nsew", padx=8, pady=(0, 8))

    def _entry_field(self, parent: tk.Widget, label: str, row: int) -> tk.Widget:
        ctk.CTkLabel(parent, text=label, text_color=self.colors["text"], font=ctk.CTkFont(size=13)).grid(
            row=row, column=0, sticky="w", padx=(14, 8), pady=6
        )
        entry = ctk.CTkEntry(parent, height=34, corner_radius=6, border_color=self.colors["border"], fg_color=self.colors["input_bg"], text_color=self.colors["text"])
        entry.grid(row=row, column=1, sticky="ew", padx=(0, 14), pady=6)
        entry.bind("<KeyRelease>", lambda _: (self._update_summary(), self._update_profile_title()))
        return entry

    def _build_settings_section(self, parent: tk.Widget) -> None:
        top = ctk.CTkFrame(parent, fg_color="transparent")
        top.pack(fill="x", padx=16, pady=(16, 10))
        ctk.CTkLabel(
            top, text="Настройки",
            font=ctk.CTkFont(size=18, weight="bold"),
            text_color=self.colors["text"],
        ).pack(side="left")

        # Theme
        theme_card = ctk.CTkFrame(parent, fg_color=self.colors.get("input_bg", self.colors["card"]),
                                  corner_radius=8, border_width=1, border_color=self.colors["border"])
        theme_card.pack(fill="x", padx=16, pady=(0, 10))
        ctk.CTkLabel(theme_card, text="Тема:", text_color=self.colors["text"]).pack(side="left", padx=12, pady=10)
        ctk.CTkSwitch(
            theme_card, text="Тёмная тема",
            variable=self.theme_var, onvalue=True, offvalue=False,
            command=self._toggle_theme,
        ).pack(side="right", padx=12, pady=10)

        # Language
        if self.i18n is not None:
            lang_card = ctk.CTkFrame(parent, fg_color=self.colors.get("input_bg", self.colors["card"]),
                                     corner_radius=8, border_width=1, border_color=self.colors["border"])
            lang_card.pack(fill="x", padx=16, pady=(0, 10))
            ctk.CTkLabel(lang_card, text="Язык / Language:",
                         text_color=self.colors["text"]).pack(side="left", padx=12, pady=10)
            self._lang_var = tk.StringVar(value=self.i18n.get_current_locale())
            ctk.CTkOptionMenu(
                lang_card, values=["ru", "en"],
                variable=self._lang_var, command=self._change_language,
            ).pack(side="right", padx=12, pady=10)

    def _change_language(self, locale: str) -> None:
        if self.i18n is None:
            return
        self.i18n.set_locale(locale)
        self.settings["language"] = locale
        save_settings(self.settings)
        self._show_message(
            "Язык / Language",
            "Язык изменён. Перезапустите приложение для полного применения.\n"
            "Language changed. Restart app to apply fully.",
        )

    def _switch_section(self, section: str) -> None:
        frame = self.section_frames.get(section)
        if frame is None:
            return
        for key, current in self.section_frames.items():
            if key == section:
                current.grid(row=0, column=0, sticky="nsew")
            else:
                current.grid_forget()
        titles = {
            "dashboard": "Dashboard",
            "network": "Network",
            "wifi": "Wifi",
            "history": "История",
            "tools": "Tools",
            "settings": "Настройки",
        }
        self.section_title.configure(text=titles.get(section, section.capitalize()))
        if hasattr(self, "network_actions"):
            if section == "network":
                self.network_actions.grid()
            else:
                self.network_actions.grid_remove()
        self._update_nav_state(section)

    def _update_nav_state(self, active: str) -> None:
        for key, btn in self.nav_buttons.items():
            if key == active:
                btn.configure(fg_color=self.colors["hover"])
            else:
                btn.configure(fg_color="transparent")

    def _update_profile_title(self, name: str | None = None) -> None:
        _ = name

    def _set_entry(self, entry: tk.Widget, value: str) -> None:
        # CTkEntry ignores delete/insert when state="disabled",
        # so temporarily unlock, write, then restore state.
        was_disabled = str(entry.cget("state")) == "disabled"
        if was_disabled:
            entry.configure(state="normal")
        entry.delete(0, "end")
        entry.insert(0, value)
        if was_disabled:
            entry.configure(state="disabled")

    def _toggle_state(self) -> None:
        ip_state = "disabled" if self.dhcp_ip.get() else "normal"
        dns_state = "disabled" if self.dhcp_dns.get() else "normal"
        for w in (self.ip, self.mask, self.gateway):
            w.configure(state=ip_state)
        for w in (self.dns1, self.dns2):
            w.configure(state=dns_state)
        self._update_summary()

    def _set_adapter_hint(self) -> None:
        pass

    def _refresh_adapters(self) -> None:
        current = self.adapter_combo.get().strip()
        self.adapters = list_network_adapters()
        self.adapter_combo.configure(values=self.adapters if self.adapters else [""])
        if current in self.adapters:
            self.adapter_combo.set(current)
        elif self.adapters:
            self.adapter_combo.set(self.adapters[0])

    def _on_select_profile(self, _: object) -> None:
        sel = self.profile_list.curselection()
        if sel:
            key = self.profile_list.get(sel[0])
            self.current_profile_key = key
            if hasattr(self, "network_tabs"):
                self.network_tabs.set("Профиль")
            self._load_profile(key)

    def _validate_profile(self, profile: NetworkProfile) -> None:
        if not profile.name.strip():
            raise ValueError("Введите имя профиля.")
        if not profile.adapter.strip():
            raise ValueError("Выберите сетевой адаптер.")

        def valid_ip(value: str, field: str) -> None:
            try:
                ipaddress.IPv4Address(value)
            except Exception as exc:
                raise ValueError(f"Некорректное значение поля '{field}': {value}") from exc

        if not profile.dhcp_ip:
            if not profile.ip or not profile.mask:
                raise ValueError("Для статического режима обязательны IP и маска.")
            valid_ip(profile.ip, "IP адрес")
            valid_ip(profile.mask, "Маска подсети")
            if profile.gateway:
                valid_ip(profile.gateway, "Шлюз")

        if not profile.dhcp_dns:
            if profile.dns_primary:
                valid_ip(profile.dns_primary, "DNS основной")
            if profile.dns_secondary:
                valid_ip(profile.dns_secondary, "DNS альтернативный")

    def _read_form(self) -> NetworkProfile:
        return NetworkProfile(
            name=self.profile_name.get().strip(),
            adapter=self.adapter_combo.get().strip(),
            dhcp_ip=self.dhcp_ip.get(),
            ip=self.ip.get().strip(),
            mask=self.mask.get().strip(),
            gateway=self.gateway.get().strip(),
            dhcp_dns=self.dhcp_dns.get(),
            dns_primary=self.dns1.get().strip(),
            dns_secondary=self.dns2.get().strip(),
        )

    def _load_profile(self, key: str) -> None:
        profile = self.profiles[key]
        # Set DHCP flags first, then enable/disable fields, then fill values.
        # CTk Entry clears its content when state changes, so fill AFTER toggle.
        self.dhcp_ip.set(profile.dhcp_ip)
        self.dhcp_dns.set(profile.dhcp_dns)
        self._toggle_state()   # enables/disables fields before we write into them
        self._set_entry(self.profile_name, profile.name)
        self.adapter_combo.set(profile.adapter if profile.adapter in self.adapters else (self.adapters[0] if self.adapters else ""))
        self._set_entry(self.ip, profile.ip)
        self._set_entry(self.mask, profile.mask)
        self._set_entry(self.gateway, profile.gateway)
        self._set_entry(self.dns1, profile.dns_primary)
        self._set_entry(self.dns2, profile.dns_secondary)
        self._update_profile_title(profile.name)

    def _refresh_profiles(self, select: str | None) -> None:
        self.profile_list.delete(0, "end")

        search = self.profile_search_var.get().strip().lower() if hasattr(self, "profile_search_var") else ""
        adapter_filter = self.profile_adapter_filter_var.get().strip() if hasattr(self, "profile_adapter_filter_var") else "Все адаптеры"

        filtered_names: list[str] = []
        adapter_values = {"Все адаптеры"}
        for name, profile in self.profiles.items():
            adapter_values.add(profile.adapter or "")
            if search and search not in name.lower():
                continue
            if adapter_filter != "Все адаптеры" and profile.adapter != adapter_filter:
                continue
            filtered_names.append(name)

        for name in filtered_names:
            self.profile_list.insert("end", name)

        if hasattr(self, "profile_adapter_filter"):
            current = self.profile_adapter_filter_var.get().strip() or "Все адаптеры"
            values = ["Все адаптеры"] + sorted(v for v in adapter_values if v)
            self.profile_adapter_filter.configure(values=values)
            if current not in values:
                self.profile_adapter_filter_var.set("Все адаптеры")

        if not filtered_names:
            self.current_profile_key = None
            return

        chosen = select if select in filtered_names else filtered_names[0]
        idx = filtered_names.index(chosen)
        self.profile_list.selection_set(idx)
        self.current_profile_key = chosen
        self._load_profile(chosen)

        if hasattr(self, "wifi_profile_combo"):
            profile_names = list(self.profiles.keys())
            self.wifi_profile_combo.configure(values=profile_names if profile_names else [""])
            current_wifi_profile = self.wifi_profile_combo.get().strip()
            if current_wifi_profile not in self.profiles and profile_names:
                self.wifi_profile_combo.set(profile_names[0])

    def _create_profile(self) -> None:
        base = "Новый профиль"
        idx = 1
        name = base
        while name in self.profiles:
            idx += 1
            name = f"{base} {idx}"
        default_adapter = self.adapters[0] if self.adapters else "Ethernet"
        new_profile = NetworkProfile(name=name, adapter=default_adapter, dhcp_ip=True, dhcp_dns=True)
        self.profiles[name] = new_profile
        save_profiles(self.profiles)
        self._refresh_profiles(select=name)
        # Explicitly clear all form fields so no previous values bleed through
        self._load_profile(name)

    def _delete_profile(self) -> None:
        sel = self.profile_list.curselection()
        if not sel:
            return
        name = self.profile_list.get(sel[0])
        del self.profiles[name]
        save_profiles(self.profiles)
        self._refresh_profiles(select=next(iter(self.profiles), None))
        self._refresh_wifi_mappings_list()

    def _duplicate_profile(self) -> None:
        sel = self.profile_list.curselection()
        if not sel:
            return
        source_name = self.profile_list.get(sel[0])
        p = self.profiles[source_name]
        idx = 2
        new_name = f"{p.name} ({idx})"
        while new_name in self.profiles:
            idx += 1
            new_name = f"{p.name} ({idx})"
        self.profiles[new_name] = NetworkProfile(**{**p.__dict__, "name": new_name})
        save_profiles(self.profiles)
        self._refresh_profiles(select=new_name)

    def _save_current_profile(self) -> None:
        try:
            profile = self._read_form()
            self._validate_profile(profile)

            selected_key = self.current_profile_key
            existing = self.profiles.get(selected_key) if selected_key else None

            if selected_key and selected_key != profile.name and selected_key in self.profiles:
                action = self._ask_rename_action(selected_key, profile.name)
                if action == "cancel":
                    return
                if action == "rename":
                    del self.profiles[selected_key]
                if action == "save_as_new" and profile.name in self.profiles:
                    overwrite = self._ask_yes_no(
                        "Подтверждение",
                        f"Профиль '{profile.name}' уже существует. Перезаписать его?",
                    )
                    if not overwrite:
                        return

            # Same name, just save — user pressed "Сохранить" intentionally.
            self.profiles[profile.name] = profile
            save_profiles(self.profiles)
            self._refresh_profiles(select=profile.name)
        except Exception as exc:
            self._show_message("Ошибка", str(exc))

    def _apply_current(self) -> None:
        try:
            profile = self._read_form()
            self._validate_profile(profile)

            conflict, conflict_message = check_ip_conflict(profile)
            if conflict:
                proceed = self._ask_yes_no(
                    "Возможный конфликт IP",
                    f"{conflict_message}\n\nПродолжить применение профиля?",
                )
                if not proceed:
                    return

            self.profiles[profile.name] = profile
            save_profiles(self.profiles)
            apply_profile_with_history(profile)
            self._refresh_profiles(select=profile.name)
            self._update_home_snapshot()
            self._refresh_history_panel()
            self._show_message("Готово", f"Профиль '{profile.name}' применен.")
        except Exception as exc:
            self._show_message("Ошибка", str(exc))

    def _export_profiles(self) -> None:
        path = filedialog.asksaveasfilename(defaultextension=".json", filetypes=[("JSON", "*.json")])
        if path:
            export_profiles(Path(path), self.profiles)

    def _import_profiles(self) -> None:
        path = filedialog.askopenfilename(filetypes=[("JSON", "*.json"), ("All files", "*.*")])
        if not path:
            return
        merged, _ = import_profiles(Path(path), self.profiles, strategy="rename")
        self.profiles = merged
        save_profiles(self.profiles)
        self._refresh_profiles(select=next(iter(self.profiles), None))

    def _update_summary(self) -> None:
        if not hasattr(self, "summary_text"):
            return

        profile = self._read_form()
        lines = [
            f"Профиль: {profile.name or '-'}",
            f"Адаптер: {profile.adapter or '-'}",
            "",
            "IP режим: DHCP" if profile.dhcp_ip else "IP режим: Статический",
        ]
        if not profile.dhcp_ip:
            lines += [f"IP: {profile.ip or '-'}", f"Маска: {profile.mask or '-'}", f"Шлюз: {profile.gateway or '-'}"]

        lines += ["", "DNS режим: DHCP" if profile.dhcp_dns else "DNS режим: Статический"]
        if not profile.dhcp_dns:
            lines += [f"DNS1: {profile.dns_primary or '-'}", f"DNS2: {profile.dns_secondary or '-'}"]

        self.summary_text.delete("1.0", "end")
        self.summary_text.insert("end", "\n".join(lines))

    def _update_home_snapshot(self) -> None:
        snapshot = get_network_snapshot()
        if hasattr(self, "home_text"):
            self.home_text.delete("1.0", "end")
            self.home_text.insert("end", snapshot)
        if hasattr(self, "network_info_text"):
            self.network_info_text.delete("1.0", "end")
            self.network_info_text.insert("end", self._format_network_snapshot(snapshot))

    def _format_network_snapshot(self, snapshot: str) -> str:
        normalized = snapshot.replace("\r\n", "\n").strip()
        if not normalized:
            return "Нет данных о сети."

        parts = [part.strip() for part in normalized.split("\n\n") if part.strip()]
        lines = ["=== ТЕКУЩАЯ СЕТЬ ===", ""]
        for idx, part in enumerate(parts, start=1):
            title = part.split("\n", 1)[0][:80]
            lines.append(f"[{idx}] {title}")
            lines.append(part)
            lines.append("")
        return "\n".join(lines).strip()

    def _rollback_last_history_apply(self) -> None:
        selected_name = self.current_profile_key if self.current_profile_key in self.profiles else None
        try:
            restored = rollback_last_successful_profile(self.profiles, profile_name=selected_name)
            self.profiles = load_profiles()
            self.current_profile_key = restored.name
            self._refresh_profiles(select=restored.name)
            self._refresh_history_panel()
            self._update_home_snapshot()
            self._show_message("Откат выполнен", f"Восстановлен профиль '{restored.name}' из истории.")
        except Exception as exc:
            self._show_message("Откат не выполнен", str(exc))

    def _refresh_history_panel(self) -> None:
        if not hasattr(self, "history_text"):
            return
        entries = load_history()
        query = self.history_search_var.get().strip().lower() if hasattr(self, "history_search_var") else ""
        status_filter = self.history_status_filter_var.get().strip() if hasattr(self, "history_status_filter_var") else "Все"

        filtered = []
        for entry in entries:
            if query and query not in entry.profile_name.lower():
                continue
            if status_filter == "Успешные" and not entry.success:
                continue
            if status_filter == "Ошибки" and entry.success:
                continue
            filtered.append(entry)

        stats = compute_history_stats(filtered)
        if hasattr(self, "history_stats_label"):
            self.history_stats_label.configure(
                text=f"Статистика: всего {stats.total} | OK {stats.success} | FAIL {stats.failed} | avg {stats.avg_duration_ms} ms"
            )

        self.history_text.delete("1.0", "end")
        if not filtered:
            self.history_text.insert("end", "История применений пока пуста для выбранных фильтров.")
            return

        lines = []
        for entry in reversed(filtered[-200:]):
            state = "OK" if entry.success else "FAIL"
            lines.append(f"[{state}] {entry.timestamp} | {entry.profile_name} | {entry.adapter} | {entry.duration_ms}ms")
            if entry.error:
                lines.append(f"  Ошибка: {entry.error}")
        self.history_text.insert("end", "\n".join(lines))

    def _toggle_wifi_auto_apply(self) -> None:
        self.settings["wifi_auto_apply"] = bool(self.wifi_auto_apply_var.get())
        save_settings(self.settings)
        if hasattr(self, "wifi_auto_status_label"):
            state = "включено" if self.wifi_auto_apply_var.get() else "выключено"
            self.wifi_auto_status_label.configure(text=f"Автоприменение: {state}")

    def _schedule_auto_switch_check(self) -> None:
        interval_sec = int(self.settings.get("wifi_auto_interval_sec", 5) or 5)
        interval_ms = max(2000, interval_sec * 1000)
        self.after(interval_ms, self._auto_switch_tick)

    def _auto_switch_tick(self) -> None:
        try:
            ssid = get_current_wifi_ssid()
            if ssid != self._last_seen_ssid:
                self._last_seen_ssid = ssid
                if hasattr(self, "current_ssid_label"):
                    self.current_ssid_label.configure(text=f"Текущий SSID: {ssid or '-'}")

            if self.wifi_auto_apply_var.get() and ssid:
                profile_name = resolve_profile_for_ssid(self.settings, ssid)
                if profile_name and profile_name in self.profiles and self._last_auto_applied_ssid != ssid:
                    profile = self.profiles[profile_name]
                    self.profiles[profile.name] = profile
                    save_profiles(self.profiles)
                    apply_profile_with_history(profile)
                    self._refresh_profiles(select=profile.name)
                    self._update_home_snapshot()
                    self._refresh_history_panel()
                    self._last_auto_applied_ssid = ssid
                    if hasattr(self, "wifi_auto_status_label"):
                        self.wifi_auto_status_label.configure(text=f"Автоприменение: SSID '{ssid}' → '{profile_name}'")
        except Exception as exc:
            if hasattr(self, "wifi_auto_status_label"):
                self.wifi_auto_status_label.configure(text=f"Автоприменение: ошибка ({exc})")
        finally:
            self._schedule_auto_switch_check()

    def _refresh_visible_wifi_list(self) -> None:
        if not hasattr(self, "wifi_visible_list"):
            return
        self.wifi_visible_list.delete(0, "end")
        networks = list_visible_wifi_networks()
        if not networks:
            self.wifi_visible_list.insert("end", "(Сети не найдены)")
            return
        for name in networks:
            self.wifi_visible_list.insert("end", name)

    def _on_select_visible_wifi(self, _: object) -> None:
        if not hasattr(self, "wifi_visible_list"):
            return
        selected = self.wifi_visible_list.curselection()
        if not selected:
            return
        value = self.wifi_visible_list.get(selected[0]).strip()
        if value and not value.startswith("("):
            self.wifi_ssid_entry.delete(0, "end")
            self.wifi_ssid_entry.insert(0, value)

    def _refresh_wifi_mappings_list(self) -> None:
        if not hasattr(self, "wifi_mappings_list"):
            return
        self.wifi_mappings_list.delete(0, "end")
        mappings = self.settings.get("wifi_mappings", [])
        for idx, item in enumerate(mappings, start=1):
            ssid = str(item.get("ssid", "")).strip()
            profile = str(item.get("profile", "")).strip()
            alias = str(item.get("name", "")).strip()
            username = str(item.get("username", "")).strip()
            details = []
            if alias:
                details.append(f"name={alias}")
            if username:
                details.append(f"user={username}")
            if item.get("auto", True):
                details.append("auto")
            tail = f" ({', '.join(details)})" if details else ""
            self.wifi_mappings_list.insert("end", f"{idx:02d}. {ssid}  →  {profile}{tail}")

    def _add_wifi_mapping(self) -> None:
        ssid = self.wifi_ssid_entry.get().strip()
        profile = self.wifi_profile_combo.get().strip()
        alias = self.wifi_alias_entry.get().strip() if hasattr(self, "wifi_alias_entry") else ""
        username = self.wifi_user_entry.get().strip() if hasattr(self, "wifi_user_entry") else ""
        auto = bool(self.wifi_mapping_auto_var.get()) if hasattr(self, "wifi_mapping_auto_var") else True
        if not ssid or not profile:
            self._show_message("Ошибка", "Укажите SSID и профиль.")
            return

        mappings = self.settings.setdefault("wifi_mappings", [])
        mappings.append({"ssid": ssid, "profile": profile, "name": alias, "username": username, "auto": auto})
        save_settings(self.settings)
        self._refresh_wifi_mappings_list()
        self._refresh_current_ssid()

    def _remove_wifi_mapping(self) -> None:
        selected = self.wifi_mappings_list.curselection()
        if not selected:
            return
        index = selected[0]
        mappings = self.settings.setdefault("wifi_mappings", [])
        if 0 <= index < len(mappings):
            mappings.pop(index)
        save_settings(self.settings)
        self._refresh_wifi_mappings_list()
        self._refresh_current_ssid()

    def _refresh_current_ssid(self) -> None:
        ssid = get_current_wifi_ssid()
        self.current_ssid_label.configure(text=f"Текущий SSID: {ssid or '-'}")

    def _apply_selected_wifi_mapping(self) -> None:
        try:
            mapping = None
            selected = self.wifi_mappings_list.curselection() if hasattr(self, "wifi_mappings_list") else ()
            mappings = self.settings.get("wifi_mappings", [])
            if selected and 0 <= selected[0] < len(mappings):
                mapping = mappings[selected[0]]
            if mapping is None:
                ssid = get_current_wifi_ssid()
                self.current_ssid_label.configure(text=f"Текущий SSID: {ssid or '-'}")
                if not ssid:
                    raise ValueError("Выберите привязку из списка или подключитесь к Wi‑Fi сети.")
                profile_name = resolve_profile_for_ssid(self.settings, ssid)
                if not profile_name:
                    raise ValueError(f"Для SSID '{ssid}' не найдена привязка.")
                mapping = {"ssid": ssid, "profile": profile_name}

            profile_name = str(mapping.get("profile", "")).strip()
            ssid_label = str(mapping.get("ssid", "")).strip()
            profile = self.profiles.get(profile_name)
            if not profile:
                raise ValueError(f"Профиль '{profile_name}' не найден.")

            self.profiles[profile.name] = profile
            save_profiles(self.profiles)
            apply_profile_with_history(profile)
            self._refresh_profiles(select=profile.name)
            self._update_home_snapshot()
            self._refresh_history_panel()
            self._show_message("Готово", f"Для SSID '{ssid_label}' применен профиль '{profile_name}'.")
        except Exception as exc:
            self._show_message("Ошибка", str(exc))

    def _run_tool(self, tool: str) -> None:
        target = self.tools_target.get().strip()
        try:
            if tool == "ping":
                output = run_ping(target or "8.8.8.8")
            elif tool == "dns":
                output = run_dns_check(target or "google.com")
            elif tool == "netstat":
                output = run_netstat()
            elif tool == "flushdns":
                ok = self._ask_yes_no(
                    "Подтверждение",
                    "Flush DNS очистит кеш DNS резолвера Windows. Временно это может привести к повторным DNS-запросам. Продолжить?",
                )
                if not ok:
                    return
                output = flush_dns()
            elif tool == "tcpreset":
                ok = self._ask_yes_no(
                    "Подтверждение",
                    "TCP/IP reset сбросит параметры TCP/IP стека к значениям по умолчанию. Может потребоваться перезагрузка и повторная настройка сети. Продолжить?",
                )
                if not ok:
                    return
                output = reset_tcp_ip()
            else:
                output = "Неизвестный инструмент."

            self.tools_output.delete("1.0", "end")
            self.tools_output.insert("end", output)
        except Exception as exc:
            self.tools_output.delete("1.0", "end")
            self.tools_output.insert("end", str(exc))

    def _show_message(self, title: str, message: str) -> None:
        dialog = ctk.CTkToplevel(self)
        dialog.title(title)
        dialog.geometry("420x180")
        dialog.transient(self)
        dialog.grab_set()
        ctk.CTkLabel(dialog, text=message, wraplength=380, justify="left").pack(fill="both", expand=True, padx=16, pady=16)
        ctk.CTkButton(dialog, text="OK", command=dialog.destroy).pack(pady=(0, 16))
        self._center_dialog(dialog, 420, 180)

    def _ask_rename_action_save(self, profile_name: str) -> str:
        """Three-button save confirmation: overwrite / save_as_new / cancel."""
        dialog = ctk.CTkToplevel(self)
        dialog.title("Сохранение профиля")
        dialog.geometry("520x220")
        dialog.transient(self)
        dialog.grab_set()
        result = {"value": "cancel"}

        ctk.CTkLabel(
            dialog,
            text=(
                f"Профиль «{profile_name}» уже существует и был изменён.\n"
                "Выберите действие:"
            ),
            wraplength=480,
            justify="left",
        ).pack(fill="both", expand=True, padx=16, pady=(16, 8))

        bar = ctk.CTkFrame(dialog, fg_color="transparent")
        bar.pack(fill="x", padx=16, pady=(0, 16))

        ctk.CTkButton(
            bar, text="Да (перезаписать)", width=150,
            command=lambda: (result.__setitem__("value", "overwrite"), dialog.destroy()),
        ).pack(side="right", padx=(8, 0))

        ctk.CTkButton(
            bar, text="Сохранить как новый", width=170,
            fg_color=self.colors["input_bg"],
            text_color=self.colors["text"],
            border_width=1, border_color=self.colors["border"],
            command=lambda: (result.__setitem__("value", "save_as_new"), dialog.destroy()),
        ).pack(side="right", padx=(8, 0))

        ctk.CTkButton(
            bar, text="Нет", width=90,
            fg_color=self.colors["input_bg"],
            text_color=self.colors["text"],
            border_width=1, border_color=self.colors["border"],
            command=dialog.destroy,
        ).pack(side="right")

        self._center_dialog(dialog, 520, 220)
        dialog.wait_window()
        return result["value"]

    def _ask_rename_action(self, old_name: str, new_name: str) -> str:
        dialog = ctk.CTkToplevel(self)
        dialog.title("Переименование профиля")
        dialog.geometry("560x240")
        dialog.transient(self)
        dialog.grab_set()
        result = {"value": "cancel"}

        ctk.CTkLabel(
            dialog,
            text=(
                f"Переименовать текущий профиль '{old_name}' в '{new_name}'?\n"
                "Выберите действие:"
            ),
            wraplength=520,
            justify="left",
        ).pack(fill="both", expand=True, padx=16, pady=(16, 8))

        button_bar = ctk.CTkFrame(dialog, fg_color="transparent")
        button_bar.pack(fill="x", padx=16, pady=(0, 16))

        ctk.CTkButton(
            button_bar,
            text="Переименовать",
            width=130,
            command=lambda: (result.__setitem__("value", "rename"), dialog.destroy()),
        ).pack(side="right", padx=(8, 0))
        ctk.CTkButton(
            button_bar,
            text="Сохранить как новый",
            width=170,
            fg_color=self.colors["input_bg"],
            text_color=self.colors["text"],
            border_width=1,
            border_color=self.colors["border"],
            command=lambda: (result.__setitem__("value", "save_as_new"), dialog.destroy()),
        ).pack(side="right", padx=(8, 0))
        ctk.CTkButton(
            button_bar,
            text="Отмена",
            width=110,
            fg_color=self.colors["input_bg"],
            text_color=self.colors["text"],
            border_width=1,
            border_color=self.colors["border"],
            command=dialog.destroy,
        ).pack(side="right")

        self._center_dialog(dialog, 560, 240)
        dialog.wait_window()
        return result["value"]

    def _ask_yes_no(self, title: str, message: str) -> bool:
        dialog = ctk.CTkToplevel(self)
        dialog.title(title)
        dialog.geometry("460x210")
        dialog.transient(self)
        dialog.grab_set()
        result = {"value": False}

        ctk.CTkLabel(dialog, text=message, wraplength=420, justify="left").pack(fill="both", expand=True, padx=16, pady=(16, 8))
        button_bar = ctk.CTkFrame(dialog, fg_color="transparent")
        button_bar.pack(fill="x", padx=16, pady=(0, 16))
        ctk.CTkButton(button_bar, text="Да", width=110, command=lambda: (result.__setitem__("value", True), dialog.destroy())).pack(side="right", padx=(8, 0))
        ctk.CTkButton(button_bar, text="Нет", width=110, fg_color=self.colors["input_bg"], text_color=self.colors["text"], border_width=1, border_color=self.colors["border"], command=dialog.destroy).pack(side="right")

        self._center_dialog(dialog, 460, 210)
        dialog.wait_window()
        return result["value"]

    def _center_dialog(self, dialog: tk.Widget, width: int, height: int) -> None:
        self.update_idletasks()
        x = self.winfo_rootx() + max(0, (self.winfo_width() - width) // 2)
        y = self.winfo_rooty() + max(0, (self.winfo_height() - height) // 2)
        dialog.geometry(f"{width}x{height}+{x}+{y}")


if __name__ == "__main__":
    ensure_admin()

    if sys.platform != "win32" and not os.environ.get("DISPLAY"):
        print("GUI cannot be started: no display is available.")
        sys.exit(0)

    # Initialise quickip service container in the background.
    # This activates structured logging, event bus and new repositories
    # without touching any app_ctk UI code.
    try:
        from quickip.app.bootstrap import bootstrap as _bootstrap
        _bootstrap(log_level="INFO")
    except Exception as _qe:
        import logging as _log
        _log.basicConfig(level=_log.INFO,
                         format='%(asctime)s %(levelname)s %(message)s',
                         handlers=[_log.FileHandler("quickip.log", encoding="utf-8")])
        _log.getLogger(__name__).warning(f"quickip bootstrap skipped: {_qe}")

    if ctk_import_error is not None:
        print(f"customtkinter import failed: {ctk_import_error}")

    if ctk is not None:
        try:
            app = QuickIPChangeCTK()
            app.mainloop()
            sys.exit(0)
        except tk.TclError as exc:
            print(f"CTk startup failed: {exc}")

    print("customtkinter не установлен. Установите зависимости:")
    print("    pip install -r requirements.txt")
    sys.exit(1)
